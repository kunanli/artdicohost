# Frontend preview only. No cloud credentials are needed in this stage.
# Reserved for a future, separately verified public API integration.
# Exact HTTPS origin only. Public metadata still controls whether registration is open.
PUBLIC_API_BASE=

# Read-only published content PREPARATION. Leave blank until the independent
# cloud staff backend is deployed and verified. Only https://api.artdico.host
# is accepted; this never enables staff login or registration on the public site.
PUBLIC_CONTENT_API_ORIGIN=

# Local staff content server only; binds 127.0.0.1 and refuses production mode.
CONTENT_API_MODE=local
CONTENT_API_PORT=8787
CONTENT_DATA_DIR=.local-data/content
# Required for local staff login; JSON array with scrypt passwordHash only.
# Optional email must be an explicit @artdico.co account; no automatic domain access.
# No default account. See docs/local-content-backend.md before configuring .env.local.
ADMIN_USERS_JSON=

# Communications preparation only. Real delivery and pass signing stay disabled.
# These server-only values are never returned by the readiness API or bundled.
COMMUNICATIONS_MODE=preview
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_ORGANIZATION_NAME=
# Paths must point to protected files outside dist/ and the repository.
APPLE_WALLET_CERT_PATH=
APPLE_WALLET_KEY_PATH=
APPLE_WALLET_WWDR_CERT_PATH=
APPLE_WALLET_KEY_PASSPHRASE=
# Actual Wallet runtime: keep disabled until an Apple Developer pass certificate,
# chain and matching key are supplied and verified. Existing *_PATH values above
# are preparation-only; FC never reads arbitrary paths from this file.
APPLE_WALLET_ENABLED=false
# Preferred for FC's 4096-byte environment: SHA-256 of a protected encrypted
# object under cms/v1/wallet-signing/<event>/<sha>.json, not a filesystem path.
APPLE_WALLET_BUNDLE_ID=
# Direct small/local configuration only. Never place real values in this file.
APPLE_WALLET_CERT_BASE64=
APPLE_WALLET_KEY_BASE64=
APPLE_WALLET_WWDR_CERT_BASE64=
APPLE_WALLET_ROOT_CERT_BASE64=
# Sender settings are server-only preparation; the domain does not verify a mailbox.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ARTDiCO HOST
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional future server authorization; never place a private key in PUBLIC_.
EMAILJS_PRIVATE_KEY=

# Never add AccessKey, GitHub tokens, session keys or personal records here.
# PUBLIC_ values can be included in browser code and must not contain secrets.

# FC automatic updates use GitHub Repository variables and existing Actions Secrets,
# not this file. See docs/automatic-fc-deployment.md for one-time console setup.
# FC listens on 9000. The controlled setup job uses Repository settings only.

# Cloud content code is packaged separately; business remains disabled.
# Leave disabled until the dedicated role, HTTPS entry, package and synthetic
# persistence acceptance have all been verified. See docs/cloud-content-setup.md.
# Server-only; never prefix these values with PUBLIC_. No real account here.
ARTDICO_CLOUD_CONTENT_ENABLED=false
ARTDICO_CONTENT_API_ORIGIN=https://api.artdico.host
ARTDICO_PUBLIC_SITE_ORIGIN=https://artdico.host
ARTDICO_CONTENT_BUCKET=artdicohost-data-hk
ARTDICO_CONTENT_REGION=cn-hongkong
# ADMIN_USERS_JSON above will also be required in protected FC configuration.
# FC supplies temporary role credentials. Never copy deployment AccessKeys or
# manually place ALIBABA_CLOUD_* credential values in this file or browser code.

# Controlled GitHub owner setup consumes ARTDICO_ADMIN_PASSWORD (Secret),
# ARTDICO_ADMIN_USERNAME and ARTDICO_ADMIN_EMAIL (Repository variables).
# Do not place their real values here. The runner derives the hash in memory
# and preserves the closed business flag; see docs/cloud-content-setup.md.

# Production registration is constructed only with a valid explicit policy,
# matching capacity, shared private storage and an independent signing secret.
# The reviewed lifecycle prepares these values in protected FC configuration;
# keep local/example values empty and do not copy a production secret here.
ARTDICO_REGISTRATION_ENABLED=false
# Initial full-capacity intake mode; persisted private admission settings override it.
# Controlled production setup explicitly enables waitlisting; staff reserve starts at 0.
ARTDICO_REGISTRATION_WAITLIST_ENABLED=false
ARTDICO_REGISTRATION_POLICY_JSON=
ARTDICO_REGISTRATION_CAPACITY=
ARTDICO_REGISTRATION_TOKEN_SECRET=

# Internal, bounded synthetic OSS acceptance only. Never enable this manually on
# an active service. The lifecycle uses a fresh run/attempt/nonce/source identity,
# keeps content closed, verifies signed evidence, then removes this value.
ARTDICO_CLOUD_ACCEPTANCE_RUN_ID=

# Optional explicit invitation email delivery. Missing provider configuration
# leaves manual invitation preparation available; it never claims email sent.
ARTDICO_INVITATION_EMAIL_ENABLED=false
# Automatic public-registration confirmation is a separate purpose/template.
# Configure the protected provider and explicitly enable before actual delivery.
ARTDICO_CONFIRMATION_EMAIL_ENABLED=false
EMAILJS_CONFIRMATION_TEMPLATE_ID=
# Preferred FC provider configuration: encrypted private object SHA-256 only;
# no mail keys are returned to the browser or copied to PUBLIC_ variables.
ARTDICO_CONFIRMATION_EMAIL_BUNDLE_ID=
# EMAIL_FROM_*/EMAILJS_* above remain server-only. Actual group QR images and
# explicit offset expiry are uploaded after superadmin login, never bundled.
