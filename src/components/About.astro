---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import planet from '../assets/home/planet-purple-grain.png';
---
<section class="ah-about ah-section" id="about" aria-labelledby="about-heading">
  <div class="ah-section-heading">
    <h2 id="about-heading" data-public-about-title>一场聚会，两种精彩。</h2>
    <p data-public-about-text>组织者与青年创作者，在同一个现场相遇。</p>
  </div>
  <div class="ah-program-grid">
    <article class="ah-program-card ah-home-program-planet" data-program="ggj" data-home-planet>
      <Image class="ah-home-program-art" src={planet} alt="" width={725} height={725} format="png" loading="lazy" decoding="async" aria-hidden="true" />
      <div class="ah-home-program-copy">
      <div class="ah-program-number"><span>01</span><Icon name="share" /></div>
      <h3 class="ah-program-title"><span>GGJ</span> <strong>中国组织者交流会</strong></h3>
      <p>交换站点经验，认识下一次一起创作的人。</p>
      <ul class="ah-program-tags" aria-label="GGJ 活动内容"><li>主题分享</li><li>组织者圆桌</li><li>新站点咨询</li></ul>
      </div>
    </article>
    <article class="ah-program-card ah-home-program-planet" data-program="artdico" data-home-planet>
      <Image class="ah-home-program-art" src={planet} alt="" width={725} height={725} format="png" loading="lazy" decoding="async" aria-hidden="true" />
      <div class="ah-home-program-copy">
      <div class="ah-program-number"><span>02</span><Icon name="gamepad" /></div>
      <h3 class="ah-program-title"><span>ARTDiCO HOST</span> <strong>学生嘉年华</strong></h3>
      <p>把想法变成作品，把作品带到大家面前。</p>
      <ul class="ah-program-tags" aria-label="学生嘉年华活动内容"><li>作品分享</li><li>游戏试玩</li><li>现场反馈</li></ul>
      </div>
    </article>
  </div>
  <div class="ah-home-fact-orbit" aria-label="现场体验">
    <div class="ah-home-fact-bubble ah-home-fact-exchange"><strong>交流</strong><span>创作经验与灵感</span><small>分享 · 圆桌 · 相遇</small></div>
    <div class="ah-home-fact-bubble ah-home-fact-creation"><strong>青年创作</strong><span>让想法来到现场</span><small>学生作品与独立游戏</small></div>
    <div class="ah-home-fact-bubble ah-home-fact-zones"><strong>A·B·C</strong><span>多种现场体验</span><small>分享 · 交流 · 展示</small></div>
    <div class="ah-home-fact-bubble ah-home-fact-play"><strong>试玩</strong><span>从体验开始对话</span><small>作品展示与现场反馈</small></div>
  </div>
</section>
