---
import { eventConfig, agenda, zones } from '../config/event.mjs';
import '../styles/program.css';
const period = (start: string) => start < '12:00' ? 'morning' : 'afternoon';
---
<section class="ah-agenda ah-program ah-section" id="agenda" aria-labelledby="agenda-heading" data-agenda>
  <div class="ah-section-heading">
    <h2 id="agenda-heading" tabindex="-1">活动日程</h2>
  </div>
  <div class="ah-program-shell">
    <div class="ah-program-datebar">
      <span class="ah-program-date" data-public-agenda-date>{eventConfig.date.label}</span>
    </div>
    <div class="ah-program-controls" data-program-controls hidden>
      <p class="ah-zone-hint">点击场地，切换日程</p>
      <div class="ah-zone-tabs" role="tablist" aria-label="选择场地日程" aria-orientation="horizontal">
        {zones.map((zone, index) => <button type="button" id={`tab-${zone.id}`} data-zone={zone.id} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`agenda-${zone.id}`} tabindex={index === 0 ? 0 : -1}><span class="ah-zone-swatch" aria-hidden="true"></span><span class="ah-zone-label"><b>{zone.id} 区</b><span class="ah-zone-name">{zone.name}</span></span><span class="ah-sr-only">{zone.description}</span></button>)}
      </div>
    </div>
    <p class="ah-agenda-caption ah-program-notice" data-public-content-status role="status"></p>
    <div class="ah-agenda-main">
      {zones.map(zone => {
        const rows = agenda.filter(item => item[zone.id as 'A' | 'B' | 'C'] !== '—');
        return <section class="ah-agenda-panel" id={`agenda-${zone.id}`} data-agenda-panel={zone.id} aria-labelledby={`program-heading-${zone.id}`} tabindex="0">
          <h3 class="ah-panel-heading" id={`program-heading-${zone.id}`}>{zone.id} 区 · {zone.name}</h3>
          {zone.id === 'C' && <p class="ah-agenda-caption ah-program-zone-note">展位与作品以已公布安排为准。</p>}
          <div class="ah-agenda-list">
            {rows.map((item, index) => <>
              {(index === 0 || period(item.start) !== period(rows[index - 1].start)) && <h4 class="ah-program-divider" data-program-divider={period(item.start)}>{period(item.start) === 'morning' ? '上午' : '午后'}<span aria-hidden="true">{period(item.start) === 'morning' ? 'MORNING' : 'AFTERNOON'}</span></h4>}
              <article id={`program-session-${item.id}-${zone.id.toLowerCase()}`} tabindex="-1" class:list={['ah-agenda-row', {'ah-featured': item.id.startsWith('student-')}]} data-agenda-start={item.start}>
                <time datetime={`${eventConfig.date.value}T${item.start}:00+08:00`}>{item.time}</time>
                <div class="ah-session-detail"><span class="ah-session-category">{zone.id} 区</span><strong>{item[zone.id as 'A' | 'B' | 'C']}</strong>{item.start === '14:30' && zone.id === 'B' && <small class="ah-session-meta">正式站点资格以 GGJ 流程为准</small>}</div>
              </article>
            </>)}
          </div>
          <p class="ah-agenda-caption ah-program-empty" data-program-empty hidden>此时段暂无已公布场次。</p>
        </section>;
      })}
    </div>
  </div>
</section>
<script>
  import '../scripts/agenda.mjs';
</script>
