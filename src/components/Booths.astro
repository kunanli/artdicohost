---
import Icon from './Icon.astro';
import { eventConfig } from '../config/event.mjs';
---
<section class="ah-booths ah-section" id="booths" aria-labelledby="booths-heading">
  <div class="ah-section-heading" id="exhibition"><h2 id="booths-heading">走近作品，遇见创作者。</h2><p>游戏试玩与开放展示 · C 区展位</p></div>
  <div class="ah-booths-empty" data-public-booths-empty><Icon name="gamepad" /><p>展位与作品名单确认后公布。</p><a class="ah-text-action" href="#registration">我有作品想展示 <span aria-hidden="true">↗</span></a></div>
  <div class="ah-public-booths" data-public-booths></div>
  <details class="ah-highlights-detail"><summary>展位申请说明 <span aria-hidden="true">＋</span></summary><p class="ah-agenda-caption">{eventConfig.exhibition.description}</p></details>
</section>
<style>
  .ah-booths-empty{padding:29px;background:#f5f7fb;border:1px solid #e4e8ef;border-radius:14px;color:#667187;text-align:center;font-size:13px}
  .ah-booths-empty :global(svg){width:29px;height:29px;color:#1448ef;margin:0 auto 8px}
  .ah-booths-empty p{line-height:1.9;margin:5px 0}
  .ah-public-booths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .ah-public-booths :global(article),.ah-public-booths :global(.ah-booth-card){padding:23px;border:1px solid #e0e7f2;border-radius:10px;background:#fff}
  .ah-public-booths :global(h3){font-size:17px;line-height:1.5;margin:9px 0;color:#15243b}
  .ah-public-booths :global(p){font-size:13px;line-height:1.8;color:#667187;margin:5px 0}
  .ah-public-booths :global(small){font-size:11px;color:#1448ef}
  @media(max-width:700px){.ah-public-booths{grid-template-columns:1fr}.ah-booths-empty{padding:24px 20px}}
</style>
