---
import { eventConfig } from '../config/event.mjs';
import { Image } from 'astro:assets';
import planet from '../assets/home/planet-purple.webp';
import ggjTitle from '../assets/home/brand-ggj.png';
import hostTitle from '../assets/home/brand-host.png';
const startsAt = `${eventConfig.date.value}T${eventConfig.time.opening}:00+08:00`;
const endsAt = `${eventConfig.date.value}T${eventConfig.time.end}:00+08:00`;
---
<section class="ah-hero ah-home-hero" id="top" aria-labelledby="hero-heading">
  <div class="ah-home-hero-stage">
    <div class="ah-home-hero-planet" aria-hidden="true" data-home-planet>
      <Image src={planet} alt="" width={1074} height={1074} loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <h1 id="hero-heading" data-public-event-title data-initial-event-title={eventConfig.title} aria-label={eventConfig.title}>
      <span class="ah-home-title-art ah-home-title-ggj" aria-hidden="true">
        <Image src={ggjTitle} alt="GLOBAL GAME JAM 中国组织者交流会" width={1227} height={229} format="png" loading="eager" decoding="async" data-home-title-image />
        <span class="ah-home-title-fallback" data-home-title-fallback hidden><span>GLOBAL GAME JAM</span><span>中国组织者交流会</span></span>
      </span>
      <span class="ah-home-title-art ah-home-title-host" aria-hidden="true">
        <Image src={hostTitle} alt="ARTDiCO HOST 嘉年华" width={981} height={225} format="png" loading="eager" decoding="async" data-home-title-image />
        <span class="ah-home-title-fallback" data-home-title-fallback hidden><span>ARTDiCO HOST</span><span>嘉年华</span></span>
      </span>
    </h1>
    <p class="ah-hero-description" data-public-hero-description>组织者交流　/　学生作品　/　游戏体验</p>
  </div>
  <div class="ah-event-meta">
    <span class="ah-home-venue"><svg class="ah-home-meta-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="56" viewBox="0 0 48 56" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M24 2C14.06 2 6 10.06 6 20c0 12.6 18 29 18 29s18-16.4 18-29C42 10.06 33.94 2 24 2Zm0 10a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z"/><ellipse cx="24" cy="49" rx="19" ry="5" stroke="currentColor" stroke-width="2.5"/></svg><span data-public-hero-venue>{eventConfig.venue.name}</span></span>
    <span class="ah-home-date"><svg class="ah-home-meta-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="23" fill="currentColor"/><path d="M24 9v15l9 7" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span><time data-public-date-value datetime={eventConfig.date.value}>{eventConfig.date.value.replaceAll('-', '/')}</time><em data-public-date-tentative hidden={eventConfig.date.status !== 'tentative'}>暂定</em><span data-public-static-hours data-home-hours>{eventConfig.time.label}</span></span></span>
  </div>
  <div class="ah-hero-actions">
    <a class="ah-primary" href="#agenda" data-home-agenda-primary>查看活动日程</a>
    <a class="ah-text-action" href="#registration" data-home-primary-apply><span data-home-primary-apply-label>查看申请说明</span><span aria-hidden="true">↗</span></a>
  </div>
  <p class="ah-fine"><span data-public-static-checkin>09:30 开始签到 · </span><span data-registration-availability>申请开放情况请查看下方说明</span></p>
  <div class="ah-event-countdown" data-event-countdown data-countdown-source-date={eventConfig.date.value} data-countdown-source-timezone={eventConfig.time.timezone} data-starts-at={startsAt} data-ends-at={endsAt} data-public-static-hours>
    <p class="ah-countdown-label" data-countdown-label hidden>距离活动开场</p>
    <div class="ah-countdown-timer" data-countdown-timer role="timer" aria-live="off" aria-label="距离活动开场" hidden>
      <span><strong data-countdown-value="days">—</strong><small>天</small></span>
      <span><strong data-countdown-value="hours">—</strong><small>时</small></span>
      <span><strong data-countdown-value="minutes">—</strong><small>分</small></span>
      <span><strong data-countdown-value="seconds">—</strong><small>秒</small></span>
    </div>
    <p class="ah-countdown-target" data-countdown-fallback><time datetime={startsAt}>{eventConfig.date.label} {eventConfig.time.opening}</time><span>北京时间 · UTC+8 开场</span></p>
    <p class="ah-countdown-status" data-countdown-status role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</section>
<script>
  import '../scripts/countdown.mjs';
</script>
