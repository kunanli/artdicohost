---
import { eventConfig } from '../config/event.mjs';
import Icon from './Icon.astro';
const [, month, day] = eventConfig.date.value.split('-');
---
<section class="ah-hero" id="top" aria-labelledby="hero-heading">
  <div class="ah-hero-copy">
    <div class="ah-eyebrow"><span class="ah-dot" aria-hidden="true"></span>GLOBAL GAME JAM × ARTDICO HOST</div>
    <h1 id="hero-heading">让创作相遇。<br />让<span>连接</span>发生。</h1>
    <p class="ah-hero-sub">{eventConfig.title}</p>
    <p class="ah-hero-description">从一座站点，到下一个创作现场。<br />与游戏创作者、组织者和生态伙伴，一起聊聊未来。</p>
    <div class="ah-event-meta">
      <span><Icon name="calendar" /><time datetime={eventConfig.date.value}>{Number(month)} 月 {Number(day)} 日</time>{eventConfig.date.status === 'tentative' && <em>暂定</em>}</span>
      <span><Icon name="pin" />{eventConfig.venue.city} · {eventConfig.venue.area}</span>
    </div>
    <div class="ah-hero-actions">
      <a class="ah-primary" href="#registration">报名参加 <span aria-hidden="true">↗</span></a>
      <a class="ah-text-action" href="#agenda">查看活动日程 <span aria-hidden="true">↓</span></a>
    </div>
    <p class="ah-fine">正式报名成功保存后即可参加 · 当前为前端体验版</p>
  </div>
  <div class="ah-poster" role="img" aria-label={`蓝色几何创作主题海报，ARTDiCO HOST ${eventConfig.year}，活动日期暂定`}>
    <div class="ah-poster-grid" aria-hidden="true"></div>
    <span class="ah-poster-top">SHENZHEN<br />CREATIVE CONNECTIONS</span>
    <span class="ah-poster-date">{month}<br /><span>{day}</span></span>
    <div class="ah-orbit" aria-hidden="true"><span></span></div>
    <div class="ah-small-orbit" aria-hidden="true"></div>
    <div class="ah-poster-type">PLAY.<br />MEET.<br />CREATE.</div>
    <div class="ah-poster-bottom"><span>ARTDiCO<br />HOST {eventConfig.year}</span><span aria-hidden="true">↗</span></div>
    <span class="ah-poster-tentative">活动日期暂定</span>
  </div>
</section>
