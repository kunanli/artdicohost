---
import { eventConfig } from '../config/event.mjs';
import Icon from './Icon.astro';
const [, month, day] = eventConfig.date.value.split('-');
---
<section class="ah-hero" id="top" aria-labelledby="hero-heading">
  <div class="ah-hero-copy">
    <p class="ah-eyebrow"><span class="ah-dot" aria-hidden="true"></span>{eventConfig.year} · 深圳前海</p>
    <h1 id="hero-heading" data-public-event-title data-initial-event-title={eventConfig.title} aria-label={eventConfig.title}>
      <span class="ah-event-title-line"><span class="ah-event-brand">GGJ</span><span class="ah-event-chinese">中国交流聚会</span></span>
      <span class="ah-event-title-cross" aria-hidden="true">×</span>
      <span class="ah-event-title-line"><span class="ah-event-brand">ARTDiCO HOST</span><span class="ah-event-chinese">学生嘉年华</span></span>
    </h1>
    <p class="ah-hero-description">组织者交流<span aria-hidden="true"> / </span>学生作品<span aria-hidden="true"> / </span>游戏体验</p>
    <div class="ah-event-meta">
      <span><Icon name="calendar" /><time data-public-date-value datetime={eventConfig.date.value}>{Number(month)} 月 {Number(day)} 日</time><em data-public-date-tentative hidden={eventConfig.date.status !== 'tentative'}>暂定</em><span data-public-static-hours><span class="ah-meta-divider" aria-hidden="true">·</span>{eventConfig.time.label}</span></span>
      <span><Icon name="pin" /><span data-public-hero-venue>{eventConfig.venue.name}</span></span>
    </div>
    <div class="ah-hero-actions">
      <a class="ah-primary" href="#agenda">查看活动日程 <span aria-hidden="true">↗</span></a>
      <a class="ah-text-action" href="#registration">了解参与方式 <span aria-hidden="true">→</span></a>
    </div>
    <p class="ah-fine"><span data-public-static-checkin>09:30 开始签到<span aria-hidden="true"> · </span></span>报名尚未开放</p>
  </div>
  <div class="ah-festival-art" aria-hidden="true">
    <div class="ah-artwork-caption"><span>PLAY. MEET. CREATE.</span><span>01 — 02</span></div>
    <svg class="ah-connection-sculpture" viewBox="0 0 640 640" fill="none">
      <defs>
        <linearGradient id="festival-blue" x1="134" y1="132" x2="440" y2="444" gradientUnits="userSpaceOnUse">
          <stop stop-color="#9EBBFF" /><stop offset=".28" stop-color="#4969F9" /><stop offset=".68" stop-color="#2440E6" /><stop offset="1" stop-color="#1428A0" />
        </linearGradient>
        <linearGradient id="festival-light" x1="242" y1="254" x2="546" y2="565" gradientUnits="userSpaceOnUse">
          <stop stop-color="#F8FCFF" /><stop offset=".38" stop-color="#CEDFFF" /><stop offset=".7" stop-color="#A1BBF8" /><stop offset="1" stop-color="#587EEB" />
        </linearGradient>
        <linearGradient id="festival-edge" x1="174" y1="178" x2="374" y2="420" gradientUnits="userSpaceOnUse">
          <stop stop-color="#AFCAFF" /><stop offset="1" stop-color="#3554EC" />
        </linearGradient>
        <filter id="festival-shadow" x="-60%" y="-60%" width="220%" height="240%"><feGaussianBlur stdDeviation="15" /></filter>
        <filter id="festival-depth" x="-30%" y="-30%" width="170%" height="180%"><feDropShadow dx="8" dy="19" stdDeviation="13" flood-color="#213CA5" flood-opacity=".2" /></filter>
      </defs>
      <ellipse cx="349" cy="551" rx="180" ry="25" fill="#657ED1" opacity=".19" filter="url(#festival-shadow)" />
      <g filter="url(#festival-depth)">
        <path d="M378 174C274 100 137 149 123 270C109 391 240 469 345 413" stroke="url(#festival-blue)" stroke-width="88" stroke-linecap="butt" />
        <path d="M266 468C370 542 507 493 521 372C535 251 404 173 299 229" stroke="url(#festival-light)" stroke-width="88" stroke-linecap="butt" />
        <path d="M123 270C109 391 240 469 345 413" stroke="url(#festival-blue)" stroke-width="88" />
        <path d="M86 276C78 349 136 416 202 435" stroke="url(#festival-edge)" stroke-width="2" opacity=".65" />
      </g>
      <g stroke="#4B65D7" stroke-width="1" opacity=".42"><path d="M62 102V122M52 112H72M560 476V496M550 486H570" /><circle cx="538" cy="138" r="4" /><circle cx="105" cy="472" r="3" /></g>
    </svg>
    <div class="ah-artwork-footer"><span class="ah-artwork-date" data-public-artwork-date>{month}<span>.</span>{day}</span><span class="ah-artwork-place">SHENZHEN<br />QIANHAI, {eventConfig.year}</span><span class="ah-artwork-arrow">↗</span></div>
  </div>
</section>
