<div class="language-picker" data-language-switch role="group" aria-label="Language / 语言" hidden>
  <button type="button" data-language="zh-CN" lang="zh-CN" aria-pressed="true">中文</button>
  <button type="button" data-language="en" lang="en" aria-pressed="false">EN</button>
</div>

<style>
  .language-picker { display: flex; flex: none; border: 1px solid #aebbd0; border-radius: 22px; overflow: hidden; }
  .language-picker[hidden] { display: none; }
  button { min-height: 44px; min-width: 44px; padding: 0 8px; border: 0; background: transparent; color: #214d93; font: inherit; cursor: pointer; }
  button[aria-pressed="true"] { background: #2555a4; color: #fff; }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }
</style>
