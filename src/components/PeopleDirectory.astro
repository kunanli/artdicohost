<section class="people-directory" data-people-directory aria-labelledby="people-directory-title">
  <div class="people-directory-metrics" data-directory-metrics></div>
  <div class="people-directory-panel">
    <header><div><h2 id="people-directory-title" data-directory-title>统一名单</h2><p data-directory-description>集中核对人员、邀约、报名与现场职责。</p></div></header>
    <form class="people-directory-search" data-directory-search><div><label for="directory-query">搜索姓名、机构或编号</label><input id="directory-query" name="query" type="search" maxlength="160" autocomplete="off" /></div><button class="ah-admin-button ah-admin-primary" type="submit">搜索</button><button class="ah-admin-button" type="reset">清除</button></form>
    <p class="people-directory-error" data-directory-error role="alert" hidden></p>
    <div class="people-directory-result"><p data-directory-status role="status" aria-live="polite">正在核对最新名单…</p><div><button type="button" class="ah-admin-button" data-directory-prev hidden>上一页</button><button type="button" class="ah-admin-button" data-directory-next hidden>下一页</button></div></div>
    <div class="people-directory-table-wrap"><table class="people-directory-table"><caption class="ah-sr-only">按明确人员关系核对邀约、报名与职责</caption><thead data-directory-head></thead><tbody data-directory-rows></tbody></table></div>
    <p class="people-directory-empty" data-directory-empty hidden>目前没有符合条件的记录。</p>
  </div>
</section>
