---
import { generalApplicationSchema } from '../../shared/public-registration-schema.mjs';
import FormField from './FormField.astro';
import RegistrationSuccess from './RegistrationSuccess.astro';
import '../styles/registration-success.css';
import '../styles/registration-policy.css';
import '../styles/general-application.css';
const field = (name: string) => {
  const definition = generalApplicationSchema.fields.find(item => item.name === name);
  if (!definition) throw new Error(`Missing application field: ${name}`);
  return definition;
};
const apiOrigin = import.meta.env.PUBLIC_API_BASE || '';
if (apiOrigin && apiOrigin !== 'https://api.artdico.host') throw new Error('申请 API 必须使用指定的 HTTPS 来源。');
---
<section class="ah-registration ah-section" id="registration" aria-labelledby="registration-heading" data-registration-api-origin={apiOrigin || undefined}>
  <div class="ah-register-intro"><h2 id="registration-heading">申请参加。</h2><p data-registration-notice>提交申请 → 主办方审核 → 确认名额与邀请</p></div>
  <div class="ah-registration-preview ah-general-application" data-registration-preview>
    <div class="ah-form-card">
      <div class="ah-form-top"><strong data-registration-open-label>活动申请</strong><span class="ah-demo-tag" data-registration-mode-label>预览 · 不提交</span></div>
      <form data-registration-form data-registration-mode="mock" data-application-intake="general-v2" method="post" novalidate autocomplete="off">
        <p class="ah-form-hint" data-registration-data-hint>带 * 为必填，其余选填。</p>
        <div class="ah-application-draft-bar"><span data-application-draft-status role="status" aria-live="polite">预览不暂存资料</span><button type="button" class="ah-text-action" data-application-draft-save>暂存草稿</button><button type="button" class="ah-text-action" data-application-draft-restore hidden>恢复本机草稿</button><button type="button" class="ah-text-action" data-application-draft-clear hidden>清除</button></div>
        <section class="ah-application-recovery" data-application-recovery hidden aria-labelledby="application-recovery-title"><h3 id="application-recovery-title">核对上次申请</h3><p data-application-recovery-person></p><p>尚未取得最终回执。下方按钮会沿用原内容与同一个申请标识核对，避免另建重复申请。请保留本页。</p></section>
        <p class="ah-form-error" data-form-error role="alert" tabindex="-1" hidden></p>
        <div data-application-edit-fields>
        <div class="ah-fields-grid">{['name','email','categories'].map(name => <FormField field={field(name)} />)}</div>
        <details class="ah-registration-extra ah-general-extra"><summary>学校、机构与其他联络信息（选填）</summary><div class="ah-fields-grid">{['organization','city','wechat'].map(name => <FormField field={field(name)} />)}</div></details>
        <label class="ah-general-proposal-toggle"><input type="checkbox" name="submitProposal" data-proposal-toggle /><span>我也想申请分享一个主题</span></label>
        <fieldset class="ah-general-proposal" data-speaker-proposal hidden disabled><legend>分享主题（选填申请）</legend><p class="ah-form-hint">与本次参会共用一份申请。主题和讲者身份另行审核，不代表已获安排。</p>{generalApplicationSchema.proposal.map(definition => <FormField field={definition} prefix="speaker" />)}</fieldset>
        <details class="ah-registration-policy" data-registration-policy hidden><summary id="registration-policy-title">查看个人信息处理告知</summary><dl data-registration-policy-details></dl></details>
        <FormField field={field('consentAccepted')} />
        </div>
        <button type="submit" data-submit class="ah-primary ah-full" disabled>检查预览</button>
        <p class="ah-form-disclaimer" data-registration-disclaimer>本机暂存不等于提交；提交后等待审核。</p>
      </form>
      <p class="ah-form-result" data-form-result role="status" aria-live="polite"></p>
      <noscript><p class="ah-form-disclaimer">申请需要启用 JavaScript。活动信息和日程仍可直接阅读。</p></noscript>
    </div>
  </div>
  <RegistrationSuccess />
</section>
<script>
  import '../scripts/registration.mjs';
  import '../scripts/registration-production.mjs';
</script>
