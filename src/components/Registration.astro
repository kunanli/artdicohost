---
import { generalApplicationSchema } from '../../shared/public-registration-schema.mjs';
import FormField from './FormField.astro';
import { PUBLIC_REGISTRATION_URL } from '../config/event.mjs';
import RegistrationSuccess from './RegistrationSuccess.astro';
import '../styles/registration-success.css';
import '../styles/general-application.css';
const field = (name: string) => {
  const definition = generalApplicationSchema.fields.find(item => item.name === name);
  if (!definition) throw new Error(`Missing application field: ${name}`);
  return definition;
};
const apiOrigin = import.meta.env.PUBLIC_API_BASE || '';
if (apiOrigin && apiOrigin !== 'https://api.artdico.host') throw new Error('申请 API 必须使用指定的 HTTPS 来源。');
---
<section class="ah-registration ah-section" id="registration" aria-labelledby="registration-heading" data-registration-api-origin={apiOrigin || undefined}>
  <div class="ah-register-intro" data-registration-intro><h2 id="registration-heading" data-registration-heading>讲者申请</h2><p data-registration-notice>提交分享主题，由筹备团队另行联系。申请不代表确认讲者或入场资格。</p><a class="ah-text-action" href={PUBLIC_REGISTRATION_URL} data-general-registration>一般参会请前往活动行报名 <span aria-hidden="true">↗</span></a></div>
  <div class="ah-registration-preview ah-general-application" data-registration-preview>
    <div class="ah-form-card">
      <div class="ah-form-top"><strong data-registration-open-label>讲者申请</strong><span class="ah-demo-tag" data-registration-mode-label hidden>预览 · 不提交</span></div>
      <form id="speaker-application" data-registration-form data-speaker-application data-registration-mode="mock" data-application-intake="general-v2" method="post" novalidate autocomplete="off">
        <p class="ah-form-hint" data-registration-data-hint>带 * 为必填，其余选填。</p>
        <div class="ah-application-draft-bar" data-application-draft-recovery hidden><span data-application-draft-status role="status" aria-live="polite"></span><button type="button" class="ah-text-action" data-application-draft-restore hidden>恢复当前输入</button></div>
        <section class="ah-application-recovery" data-application-recovery hidden aria-labelledby="application-recovery-title"><h3 id="application-recovery-title">核对上次申请</h3><p data-application-recovery-person></p><p>尚未取得上次申请的最终回执。此处只核对原内容，不会改为新的讲者申请；请保留本页。</p></section>
        <p class="ah-form-error" data-form-error role="alert" tabindex="-1" hidden></p>
        <div data-application-edit-fields>
        <div class="ah-fields-grid">{['name','email','phone','wechat','categories'].map(name => <FormField field={field(name)} />)}</div>
        <details class="ah-registration-extra ah-general-extra"><summary>学校、机构与其他信息（选填）</summary><div class="ah-fields-grid">{['organization','city'].map(name => <FormField field={field(name)} />)}</div></details>
        <fieldset class="ah-general-proposal" data-speaker-proposal><legend>分享主题</legend><p class="ah-form-hint">请填写拟分享的主题和简介。一般参会请在活动行报名，讲者安排另行确认。</p>{generalApplicationSchema.proposal.map(definition => <FormField field={definition} prefix="speaker" />)}</fieldset>
        <FormField field={field('consentAccepted')} />
        </div>
        <button type="submit" data-submit class="ah-primary ah-full" disabled>检查讲者申请</button>
        <p class="ah-form-disclaimer" data-registration-disclaimer>提交成功仅表示已收到讲者申请。</p>
      </form>
      <p class="ah-form-result" data-form-result role="status" aria-live="polite"></p>
      <noscript><p class="ah-form-disclaimer">申请需要启用 JavaScript。活动信息和日程仍可直接阅读。</p></noscript>
    </div>
  </div>
  <RegistrationSuccess />
</section>
<script>
  import '../scripts/registration.mjs';
  import '../scripts/registration-production.mjs';
</script>
