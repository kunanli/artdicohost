---
import SiteLayout from '../layouts/SiteLayout.astro';
import StaffNavigation from './StaffNavigation.astro';
import StaffSettings from './StaffSettings.astro';
import StaffDeliverySettings from './StaffDeliverySettings.astro';
import '../styles/admin.css';
import '../styles/registration-review.css';
import '../styles/settings-workspace.css';
import {SETTINGS_PAGES,settingsPageHref} from '../lib/admin-sections.mjs';
interface Props { section?: string }
const {section='overview'}=Astro.props;
const page=SETTINGS_PAGES.find(item=>item.key===section);
if(section!=='overview'&&!page)throw new TypeError('Unknown settings page');
const title=page?.title??'设置与通知';
---
<SiteLayout title={`${title}｜ARTDiCO HOST`} description="工作人员管理确认通知、入群图片与票券设置。">
  <div class="ah-admin" data-settings-admin data-settings-section={section}>
    <header class="ah-admin-header"><a class="ah-admin-brand" href="/admin/">ARTDiCO <span>HOST</span></a><a class="ah-admin-back" href="https://artdico.host">查看活动页面 ↗</a></header>
    <main class="ah-admin-main" id="main-content">
      <p class="ah-admin-status" data-settings-page-status role="status" aria-live="polite"></p>
      <p class="ah-admin-alert" data-settings-page-error role="alert" tabindex="-1" hidden></p>
      <section class="ah-admin-login-card" data-settings-login-panel aria-labelledby="settings-login-title">
        <h1 id="settings-login-title">设置与通知</h1><p class="ah-admin-intro">活动协作账号可管理通知与群码；账号和备份由管理员维护。</p>
        <form method="post" data-settings-login><div class="ah-admin-field"><label for="settings-username">用户名或邮箱</label><input id="settings-username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="160" required /></div><div class="ah-admin-field"><label for="settings-password">密码</label><input id="settings-password" name="password" type="password" autocomplete="current-password" maxlength="1024" required /></div><button type="submit" class="ah-admin-button ah-admin-primary" data-settings-login-submit disabled>登录后台 →</button></form>
      </section>
      <div class="settings-workspace-account" data-settings-account hidden><span data-settings-user></span><button type="button" class="ah-admin-text-button" data-settings-logout>退出登录</button></div>
      <section class="ah-admin-workspace-layout" data-settings-workspace hidden aria-labelledby="settings-workspace-title">
        <StaffNavigation current="settings" />
        <div class="ah-admin-workspace-content">
          <div class="ah-admin-page-heading"><div><h1 id="settings-workspace-title">{title}</h1><p data-settings-page-description>{page?.description??'选择要管理的设置。'}</p></div><button type="button" class="ah-admin-button" data-settings-refresh hidden={section==='overview'||section==='invitations'}>刷新本页状态</button></div>
          <p class="ah-admin-alert" data-settings-access-denied hidden>此账号未具备完整活动协作权限，可从左侧返回自己的工作区。</p>
          <div data-settings-authorized hidden>
            <nav class="settings-workspace-overview" data-settings-panel="overview" hidden={section!=='overview'} aria-label="设置入口">
              <a href={settingsPageHref('delivery')}><strong>确认信与 Apple Wallet</strong><span data-settings-mail-summary>寄件与票券设置</span><small data-settings-wallet-summary>Apple Developer 与签章就绪后开放 Wallet。</small></a>
              <a href={settingsPageHref('group')}><strong>微信群入口</strong><span data-settings-group-summary>群码图片与有效期</span><small>上传、替换或关闭入群图片。</small></a>
              <a href={settingsPageHref('invitations')}><strong>工作人员邀请</strong><span>报名邀请与个人邀请函</span><small>核对人员后明确下载或寄送。</small></a>
              <a href={settingsPageHref('accounts')} data-settings-accounts-link hidden><strong>工作人员账号</strong><span>新增、权限与停用</span><small>仅管理员；含加密备份与隔离恢复。</small></a>
            </nav>
            <p class="ah-admin-small settings-local-note" data-settings-local-note hidden={section==='overview'||section==='invitations'}>可恢复本机草稿；保存按钮负责保存到云端。密码、密钥与图片不暂存。</p>
            <div data-settings-panel="delivery" hidden={section!=='delivery'}><StaffDeliverySettings /></div>
            <section class="ah-admin-panel settings-invitation-help" data-settings-panel="invitations" hidden={section!=='invitations'} aria-labelledby="invitation-settings-title"><h2 id="invitation-settings-title">工作人员邀请</h2><p>意向代登记对象使用独立的报名邀请。到人员工作页核对名额与联络同意后，再明确下载或寄送；开启自动确认信不会补寄历史名单。</p><a class="ah-admin-button" href="/admin/contacts/">前往人员与邀约</a></section>
            <StaffSettings />
          </div>
        </div>
      </section>
    </main>
    <footer class="ah-admin-footer"><span>ARTDiCO HOST</span><a href="/admin/tasks/">今日待办</a></footer>
  </div>
  <script>import '../scripts/settings.mjs';</script>
</SiteLayout>
