---
import { PUBLIC_REGISTRATION_URL } from '../config/event.mjs';
import '../styles/navigation.css';
import '../styles/home-header.css';
const links = [
  { href: '#top', label: '首页' },
  { href: '#about', label: '亮点' },
  { href: '#guests', label: '嘉宾阵容' },
  { href: '#agenda', label: '日程' },
  { href: '#recruitment', label: '参与指引' },
  { href: '#faq', label: '常见问题' },
];
---
<header class="ah-header ah-home-header" data-home-header data-scrolled="false">
  <a class="ah-home-wordmark" href="#top" aria-label="ARTDiCO HOST 活动首页">ARTDiCO HOST</a>
  <nav class="ah-home-desktop-nav" aria-label="页面导航">
    {links.map(link => <a href={link.href}>{link.label}</a>)}
    <a href={PUBLIC_REGISTRATION_URL} class="ah-home-nav-apply" data-general-registration>活动行报名</a>
  </nav>
  <div class="ah-language-switch" data-language-switch role="group" aria-label="Language / 语言" hidden>
    <button type="button" data-language="zh-CN" lang="zh-CN" aria-pressed="true">中文</button>
    <button type="button" data-language="en" lang="en" aria-pressed="false">EN</button>
  </div>
  <details class="ah-site-menu" data-site-menu data-mobile-nav>
    <summary aria-controls="site-navigation">菜单 <span class="ah-menu-icon" aria-hidden="true"><span></span><span></span></span></summary>
    <nav id="site-navigation" aria-label="页面导航">
      {links.map(link => <a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}
      <a href="#venue">地点与常见问题<span aria-hidden="true">↗</span></a>
      <a href={PUBLIC_REGISTRATION_URL} class="ah-menu-action" data-general-registration>活动行报名<span aria-hidden="true">↗</span></a>
    </nav>
  </details>
</header>
<script>
  import '../scripts/navigation.mjs';
</script>
