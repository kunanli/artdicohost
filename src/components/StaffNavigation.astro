---
interface Props { current: 'content' | 'tasks' | 'contacts' | 'registrations' }
const { current } = Astro.props;
const pages = [
  { key: 'tasks', href: '/admin/tasks/', label: '今日待办' },
  { key: 'contacts', href: '/admin/contacts/', label: '人员与邀约' },
  { key: 'registrations', href: '/admin/registrations/', label: '报名与审核' },
  { key: 'content', href: '/admin/', label: '活动与内容' },
];
const sections = [
  ['workspace-title', '工作区概况'],
  ['event-editor-title', '活动基本资料'],
  ['arrangements-title', '现场配置总览'],
  ['guests-title', '嘉宾与讲者'],
  ['organizations-title', '参与组织'],
  ['showcases-title', '学生作品'],
  ['sessions-title', '活动场次'],
  ['booths-title', '十五个展位'],
];
---
<aside class="ah-staff-navigation" data-staff-navigation>
  <details data-staff-navigation-menu>
    <summary>快捷导航 <span aria-hidden="true">⌄</span></summary>
    <nav aria-label="后台快捷导航">
      <div class="ah-staff-navigation-pages">
        {pages.map(page => <a href={page.href} aria-current={current === page.key ? 'page' : undefined}>{page.label}</a>)}
      </div>
      {current === 'content' && <div class="ah-staff-navigation-sections" aria-label="活动内容区块">
        {sections.map(([id, label]) => <a href={'#' + id} data-staff-section-link>{label}</a>)}
      </div>}
    </nav>
  </details>
</aside>
<script>import '../scripts/staff-navigation.mjs';</script>
