---
import { eventConfig, faqItems } from '../config/event.mjs';
import Icon from './Icon.astro';
---
<section class="ah-bottom-grid ah-section" aria-label="地点与常见问题">
  <div class="ah-venue" id="venue"><span class="ah-kicker">MEET IN QIANHAI / 活动地点</span><h2>{eventConfig.venue.city} · {eventConfig.venue.area}</h2><p class="ah-venue-name" data-public-event-venue>{eventConfig.venue.name}</p><p>A 区阶梯展示厅 / B 区咖啡厅 / C 区外围展位区<br />{eventConfig.venue.addressStatus}。</p>{eventConfig.venue.mapUrl ? <a class="ah-secondary" href={eventConfig.venue.mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin" />打开地图</a> : <button type="button" class="ah-secondary" disabled><Icon name="pin" />地图指引待确认</button>}</div>
  <div class="ah-faq" id="faq"><span class="ah-kicker">GOOD TO KNOW / 常见问题</span>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
</section>
<section class="ah-privacy ah-section" id="privacy" aria-labelledby="privacy-heading">
  <span class="ah-kicker">YOUR INFORMATION / 资料与隐私</span><h2 id="privacy-heading">认真对待每一份信任。</h2>
  <p>{eventConfig.privacy.notice}</p>
  <details><summary>查看正式报名开放前的准备事项 <span aria-hidden="true">+</span></summary><p>处理者名称与联系邮箱、实际存储地区、保留期限、资料查阅、更正、撤回及删除方式，均待责任方核定。当前表单只用于本地交互体验，不发送或保存填写内容。正式服务不会在第一阶段收取身份证、护照、酒店订单或财务账单；向外部代表分享个人信息前须另行确认适用范围及告知授权。</p></details>
</section>
