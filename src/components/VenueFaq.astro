---
import { eventConfig, faqItems } from '../config/event.mjs';
import Icon from './Icon.astro';
import { publicFaqItems } from '../lib/public-faq.mjs';
---
<section class="ah-bottom-grid ah-section" aria-label="地点与常见问题">
  <div class="ah-venue" id="venue"><span class="ah-kicker">活动地点</span><h2>{eventConfig.venue.city} · {eventConfig.venue.area}</h2><p class="ah-venue-name" data-public-event-venue>{eventConfig.venue.name}</p><p>{eventConfig.venue.address}</p><a class="ah-secondary" data-public-map hidden target="_blank" rel="noopener noreferrer">打开地图</a><a class="ah-secondary" data-public-contact-email hidden>联络筹备团队</a>{eventConfig.venue.mapUrl ? <a class="ah-secondary" href={eventConfig.venue.mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin" />打开地图</a> : <p class="ah-venue-directions">入口与交通指引将另行公布。</p>}<details class="ah-highlights-detail"><summary>场地分区 <span aria-hidden="true">＋</span></summary><p class="ah-agenda-caption">A 区 · 阶梯展示厅<br />B 区 · 咖啡厅<br />C 区 · 外围展位区</p><p class="ah-agenda-caption">{eventConfig.venue.addressStatus}</p></details></div>
  <div class="ah-faq" id="faq"><h2>展会指南 Q&amp;A</h2><div class="ah-faq-chat" data-public-faq>{publicFaqItems(faqItems).map(item => <details class="ah-faq-message" open id={'faq-'+item.id} data-faq-id={item.id}><summary class="ah-faq-question">{item.question}<span aria-hidden="true">+</span></summary><p class="ah-faq-answer">{item.answer}</p>{item.registrationUrl && <p class="ah-faq-registration"><a class="ah-text-action" href={item.registrationUrl} data-general-registration={item.id==='wallet-card'?undefined:''}>{item.id==='wallet-card'?'申请电子纪念卡':'前往活动行报名'}</a></p>}{item.contactEmail && <p class="ah-faq-contact" data-email={item.contactEmail}><a href={'mailto:'+encodeURIComponent(item.contactEmail).replaceAll('%40','@')}>{item.contactEmail}</a><button type="button" class="ah-faq-copy" data-faq-copy-email={item.contactEmail}>复制邮箱</button><span class="ah-faq-copy-status" role="status" aria-live="polite"></span></p>}</details>)}</div></div>
</section>
<section class="ah-privacy ah-section" id="privacy" aria-labelledby="privacy-heading">
  <details class="ah-highlights-detail"><summary id="privacy-heading">资料与隐私 <span aria-hidden="true">＋</span></summary><div data-public-privacy><p>{eventConfig.privacy.notice}</p><p>本站正式表单启用前，将核定处理者、联系邮箱、存储地区、保留期限及查阅、更正、撤回、删除方式。第一阶段不收取证件、酒店订单或财务账单；对外分享个人信息须另行告知并取得适用授权。</p></div></details>
</section>
