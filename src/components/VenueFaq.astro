---
import { eventConfig, faqItems } from '../config/event.mjs';
import Icon from './Icon.astro';
---
<section class="ah-bottom-grid ah-section" aria-label="地点与常见问题">
  <div class="ah-venue" id="venue"><span class="ah-kicker">活动地点</span><h2>{eventConfig.venue.city} · {eventConfig.venue.area}</h2><p class="ah-venue-name" data-public-event-venue>{eventConfig.venue.name}</p><p>{eventConfig.venue.address}</p>{eventConfig.venue.mapUrl ? <a class="ah-secondary" href={eventConfig.venue.mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin" />打开地图</a> : <p class="ah-venue-directions">入口与交通指引将另行公布。</p>}<details class="ah-highlights-detail"><summary>场地分区 <span aria-hidden="true">＋</span></summary><p class="ah-agenda-caption">A 区 · 阶梯展示厅<br />B 区 · 咖啡厅<br />C 区 · 外围展位区</p><p class="ah-agenda-caption">{eventConfig.venue.addressStatus}</p></details></div>
  <div class="ah-faq" id="faq"><h2>参加前，你可能想知道。</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
</section>
<section class="ah-privacy ah-section" id="privacy" aria-labelledby="privacy-heading">
  <details class="ah-highlights-detail"><summary id="privacy-heading">资料与隐私 <span aria-hidden="true">＋</span></summary><p>{eventConfig.privacy.notice}</p><p>本站正式表单启用前，将核定处理者、联系邮箱、存储地区、保留期限及查阅、更正、撤回、删除方式。第一阶段不收取证件、酒店订单或财务账单；对外分享个人信息须另行告知并取得适用授权。</p></details>
</section>
