---
import FormField from './FormField.astro';
import { PUBLIC_REGISTRATION_URL } from '../config/event.mjs';
import { CARD_COMMUNITY_FIELD_LENGTH, CARD_PROFILE_FIELD_LENGTHS, WALLET_IDENTITIES } from '../../shared/general-application.mjs';
const apiOrigin=import.meta.env.PUBLIC_API_BASE||'';
if(apiOrigin&&apiOrigin!=='https://api.artdico.host')throw new Error('纪念卡 API 必须使用指定的 HTTPS 来源。');
const fields=[
 {name:'huodongxingReference',label:'活动行报名编号',type:'text',required:true,maxLength:160,hint:'可填写本场活动的报名号、订单号或票号，供工作人员核对。'},
 {name:'name',label:'姓名',type:'text',required:true,minLength:2,maxLength:80,hint:'请与活动行报名姓名一致。'},
 {name:'email',label:'Email',type:'email',required:true,maxLength:254,hint:'用于接收电子纪念卡领取链接。'},
 {name:'wechat',label:'微信号',type:'text',required:true,maxLength:100},
 {name:'requestedWalletIdentity',label:'本次活动身份',type:'select',required:false,options:[...WALLET_IDENTITIES]},
 {name:'ggjSite',label:'GGJ 站点或社群',type:'text',required:false,maxLength:CARD_COMMUNITY_FIELD_LENGTH,
  hint:'可填写曾参与的 GGJ 站点或社群。'},
];
const involvement={name:'ggjRole',label:'GGJ 参与经历',type:'text',required:false,maxLength:CARD_COMMUNITY_FIELD_LENGTH,
 suggestions:['站点组织者','Jammer','导师','志愿者','评审','教育工作者','社群伙伴','活动运营','程序','美术','策划','音频','制作人','测试','叙事设计'],
 hint:'可填写你在 GGJ 的角色、贡献或参与年份，例如「导师 · 2024」。'};
---
<section class="ah-registration ah-section" id="wallet-card-application" aria-labelledby="wallet-card-heading" data-wallet-api-origin={apiOrigin||undefined}>
 <div class="ah-register-intro"><h2 id="wallet-card-heading">电子纪念卡申请</h2><p>已在活动行报名？工作人员核对申请后会寄出领取链接。打开即可下载 JPEG，也可在 iPhone 上加入 Apple Wallet。</p><a class="ah-text-action" href={PUBLIC_REGISTRATION_URL} data-general-registration>尚未报名？前往活动行 <span aria-hidden="true">↗</span></a></div>
 <div class="ah-registration-preview ah-general-application"><div class="ah-form-card">
  <div class="ah-form-top"><strong>电子纪念卡</strong></div>
  <form data-wallet-form method="post" novalidate autocomplete="off">
   <p class="ah-form-hint">带 * 为必填。工作人员将核对本次活动身份和你填写的 GGJ 资料。</p>
   <p class="ah-form-hint" data-wallet-config-status role="status" aria-live="polite"></p>
   <button type="button" class="ah-text-action" data-wallet-config-retry hidden>重试连接</button>
   <p class="ah-form-hint" data-wallet-draft-status role="status" aria-live="polite"></p><button type="button" class="ah-text-action" data-wallet-draft-restore hidden>恢复本机申请</button>
   <p class="ah-form-error" data-wallet-error role="alert" tabindex="-1" hidden></p>
   <div class="ah-fields-grid">
    {fields.map(field=><FormField field={field} prefix="wallet" />)}
    <div class="ah-ggj-involvement">
     <FormField field={involvement} prefix="wallet" />
     <label class="ah-demo-consent"><input type="checkbox" data-ggj-jammer aria-controls="field-wallet-ggjRole" disabled /><span>Jammer（参加过 Game Jam）</span></label>
    </div>
   </div>
   <details class="ah-general-extra"><summary>电话与学校／机构（选填）</summary><div class="ah-fields-grid">{[{name:'phone',label:'电话',type:'tel',required:false,maxLength:CARD_PROFILE_FIELD_LENGTHS.phone,hint:'经核对后会显示在 Wallet 票券详情及 JPEG。'},{name:'organization',label:'学校／机构／团队',type:'text',required:false,maxLength:CARD_PROFILE_FIELD_LENGTHS.organization,hint:'经核对后会显示在纪念卡上。'}].map(field=><FormField field={field} prefix="wallet" />)}</div></details>
   <div class="ah-consent-field"><label class="ah-demo-consent" for="wallet-consent"><input type="checkbox" id="wallet-consent" name="wallet.consentAccepted" required /><span>我已阅读并同意<a href="#privacy">隐私说明</a>。</span></label></div>
   <button type="submit" data-wallet-submit class="ah-primary ah-full" disabled>正在确认申请服务…</button>
   <p class="ah-form-disclaimer">纪念卡供收藏。现场签到请使用活动行原电子票。</p>
  </form>
  <div data-wallet-result role="status" aria-live="polite" tabindex="-1" hidden></div>
  <noscript><p class="ah-form-disclaimer">纪念卡申请需要启用 JavaScript。</p></noscript>
 </div></div>
</section>
<script>import '../scripts/wallet-application.mjs';</script>
<style>
 .ah-ggj-involvement { min-width: 0; margin-bottom: 18px; }
 :global(#artdico-host) .ah-ggj-involvement :global(.ah-field) { margin-bottom: 0; }
 :global(#artdico-host) .ah-ggj-involvement > label { min-height: 44px; align-items: center; margin-top: 0; }
</style>
