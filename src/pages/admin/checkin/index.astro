---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { PUBLIC_REGISTRATION_URL } from '../../../config/event.mjs';
import '../../../styles/admin.css';
---
<SiteLayout title="现场签到已移至活动行｜ARTDiCO HOST" description="工作人员在活动行核验原电子票并签到。">
  <Fragment slot="head">
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <script is:inline>if (location.hash || location.search) history.replaceState(null, '', location.pathname);</script>
  </Fragment>
  <div class="ah-admin">
    <header class="ah-admin-header"><a class="ah-admin-brand" href="/admin/">ARTDiCO <span>HOST</span></a></header>
    <main id="main-content" class="ah-admin-main">
      <section class="ah-admin-panel">
        <h1>现场签到已移至活动行</h1>
        <p>请在活动行工作人员端扫描参会者的活动行原电子票。</p>
        <p><a href={PUBLIC_REGISTRATION_URL} rel="noreferrer">前往活动行活动页</a></p>
        <p><a href="/admin/contacts/">返回人员名单</a></p>
      </section>
    </main>
  </div>
</SiteLayout>
