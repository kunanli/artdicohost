---
import StaffNavigation from '../../../components/StaffNavigation.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { sourceLabels } from '../../../../shared/contact-import.mjs';
import { eventConfig } from '../../../config/event.mjs';
import '../../../styles/admin.css';
import '../../../styles/contacts.css';
import '../../../styles/people-relationships.css';
const participationForms = [
  ['guest', '嘉宾'], ['speaker', '讲者'], ['panelist', '圆桌嘉宾'], ['host', '主持'], ['organizer', '研讨会组织者'],
  ['booth', '展位'], ['student_showcase', '学员作品展示'], ['attendee', '现场参与'],
];
const profileFields: [string, string, number][] = [
  ['name', '姓名', 120], ['displayName', '邀请称呼', 120], ['city', '城市', 160],
  ['organization', '机构 / 团队', 300], ['position', '职务', 200], ['email', '邮箱', 254],
  ['wechat', '微信', 150], ['phone', '电话', 150], ['website', '网站', 2048],
  ['siteName', '站点名称', 300], ['siteRole', '站点职务', 300],
];
---
<SiteLayout title="人员与邀约｜ARTDiCO HOST" description="工作人员私有名单、活动安排与邀请函生成。">
  <div class="ah-admin contacts-app">
    <header class="ah-admin-header"><a class="ah-admin-brand" href="https://artdico.host">ARTDiCO <span>HOST / PEOPLE</span></a><nav aria-label="公开活动页面"><a class="ah-admin-back" href="https://artdico.host">查看活动页面 <span aria-hidden="true">↗</span></a></nav></header>
    <main class="ah-admin-main" id="main-content">
      <div class="ah-admin-environment" data-contacts-environment><span class="ah-admin-dot" aria-hidden="true"></span><p><strong>私有邀约工作区</strong>名单仅供有邀约权限的工作人员查看。导入、生成邀请函及记录发出均不会自动联系任何人。</p></div>
      <p data-contacts-status class="ah-admin-status" role="status" aria-live="polite"></p><p data-contacts-error class="ah-admin-alert" role="alert" hidden></p>
      <section data-contacts-login-panel class="ah-admin-login-card"><span class="ah-admin-eyebrow">PEOPLE & PLANNING</span><h1>人员与邀约管理</h1><p class="ah-admin-intro">使用具备「邀约管理」权限的工作人员账号登录。</p><form method="post" data-contacts-login><div class="ah-admin-field"><label for="contacts-user">用户名或邮箱</label><input id="contacts-user" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="160" placeholder="用户名或 @artdico.co 邮箱" /></div><div class="ah-admin-field"><label for="contacts-password">密码</label><input id="contacts-password" name="password" type="password" autocomplete="current-password" required maxlength="1024" /></div><button type="submit" class="ah-admin-button ah-admin-primary" data-contacts-login-submit disabled>登录人员后台 →</button></form><noscript><p>启用 JavaScript 后才可登录和操作，不会直接提交账号资料。</p></noscript></section>
      <div class="contacts-account" data-contacts-account hidden><span data-contacts-user></span><button type="button" class="ah-admin-text-button" data-contacts-logout>退出登录</button></div>
      <section class="ah-admin-workspace-layout" data-contacts-workspace hidden>
        <StaffNavigation current="contacts" />
        <div class="ah-admin-workspace-content">
        <div class="ah-admin-page-heading"><div><h1>人员与邀约</h1><p>从沟通回复，继续核对名额、组织关系与现场安排。</p></div><div class="contacts-action-row"><a class="ah-admin-button" href="/admin/volunteers/">志愿者与分工</a><button type="button" class="ah-admin-button" data-contacts-refresh>刷新名单</button><button type="button" class="ah-admin-button ah-admin-primary" data-contact-new>＋ 新增联系人</button></div></div>
        <div class="contacts-metrics people-overview" data-contacts-metrics data-people-overview></div><p class="ah-admin-small people-source-status" data-people-relationships-status role="status"></p><p class="ah-admin-small" data-contacts-progress-note></p><p class="contacts-planning-summary" data-contacts-planning></p>
        <section class="contacts-conversion ah-admin-panel"><div><h2>报名名额与邀请</h2><p class="ah-admin-small" data-contacts-conversion-note>报名转换服务尚未就绪；名单、跟进与现场安排仍可分别维护。</p></div><div class="contacts-action-row"><button type="button" class="ah-admin-button" data-contacts-sync-attending disabled>核对已答应但未报名人员</button><span data-contacts-selected>已选 0 位</span><button type="button" class="ah-admin-button" data-contacts-select-visible>选择当前筛选</button><button type="button" class="ah-admin-button" data-contacts-clear-selection>清除选择</button><button type="button" class="ah-admin-button ah-admin-primary" data-contacts-convert disabled>将所选对象代登记</button><button type="button" class="ah-admin-button" data-contacts-batch-invite disabled>批量准备邀请 PNG ZIP</button></div></section>
        <section class="ah-admin-panel contacts-batch-panel" data-batch-panel hidden><h2>批量邀请准备结果</h2><p data-batch-summary role="status" aria-live="polite"></p><a class="ah-admin-button ah-admin-primary" data-batch-download hidden>下载本次邀请 ZIP</a><p class="ah-admin-small">仅准备和下载，不代表已发出。请通过已核对的渠道逐人发送，再记录实际发出；结果不明的对象先核对，不自动重试。</p><ul data-batch-results></ul></section>
        <section class="ah-admin-panel" data-contacts-import-panel hidden><div class="ah-admin-section-heading"><div><span class="ah-admin-eyebrow">IMPORT</span><h2>导入意向名单</h2><p>先核对预览再入库。重复导入同一份问卷不会新增重复对象，也不会覆盖跟进备注。</p></div></div><div class="contacts-import"><label class="ah-admin-button contacts-file">选择原始文件<input type="file" accept=".xlsx,.json" data-contacts-file /></label><span data-contacts-file-name>支持原始 Excel 问卷或旧后台 contacts.json 快照</span><p class="ah-admin-small">支持序号版与文本版；选项已按文本逐笔核对。原意向与后续实际回复独立保存。</p><div data-import-preview hidden><p data-import-summary></p><div class="contacts-preview-rows" data-import-rows></div><label class="contacts-check"><input type="checkbox" data-import-duplicates />我已核对可能重复的联系方式，确认保留为独立对象</label><label class="contacts-check"><input type="checkbox" data-import-source-confirm />我已核对原始文件、来源与使用授权，确认仅导入本次活动所需资料</label><button type="button" class="ah-admin-button ah-admin-primary" data-import-confirm disabled>确认导入</button><button type="button" class="ah-admin-button" data-import-cancel>取消</button></div></div></section>
        <section class="ah-admin-panel contacts-roster-export" data-contacts-export-panel hidden><div class="ah-admin-section-heading"><div><h2>导出完整人员名单</h2><p>保留全部已保存对象，包括未转报名、候补与已拒绝对象；不受下方搜索及筛选影响。导出不删除或改变原始资料。</p></div></div><div class="contacts-export-options"><label class="contacts-check"><input type="checkbox" data-contacts-export-contact />包含邮箱、微信与电话等联络资料</label><label class="contacts-check"><input type="checkbox" data-contacts-export-answers />包含完整已保存回答与内部备注</label><button class="ah-admin-button" type="button" data-contacts-export disabled>导出全部已保存人员 Excel</button><p class="ah-admin-small">默认仅导出必要身份、回复与安排。完整回答／备注可能包含自由文字联络信息，分享前请核对。收到后台导出审计回执后才提供私密下载。</p></div></section>
        <section class="ah-admin-panel"><div class="ah-admin-section-heading"><div><h2>邀约回复与参与安排</h2><p>邀请函、人工发出、实际回复与参与形式分别保存。准备嘉宾资料不会自动确认出席或公开。</p></div><span data-contacts-result-count></span></div><details class="contacts-list-guide" data-contacts-guide><summary>如何安排这份名单</summary><ol><li><strong>核对原始意向：</strong>查看导入来源、原问卷与联络许可；同名不会自动合并。</li><li><strong>联络与实际回复：</strong>准备邀请、记录人工发出，再单独保存对方回复；服务商接受不等于送达或答应出席。</li><li><strong>确认名额与关系：</strong>保存本人已答应参加后，核对正式名额或候补回执；在「详情与安排」选择实际职责及明确组织成员关系。</li><li><strong>安排场次／展位：</strong>按已选职责关联对应场次或展位；一般参与者不必配置讲者场次或展位。</li><li><strong>核对公开资料：</strong>需要对外展示时，通过「管理嘉宾资料」编辑照片、简介与公开职责并核对授权。</li></ol><p class="ah-admin-small">从每行「个人工作页」集中核对负责人、下次跟进、备注、名额与安排；用「详情与安排」继续修改。意向、报名、实际回复与公开资料分别保留。</p></details><div class="contacts-filters"><div class="ah-admin-field"><label for="contacts-organization">关联组织</label><select id="contacts-organization" data-contacts-organization><option value="">全部组织关系</option><option value="__none">尚未关联组织</option></select></div><div class="ah-admin-field"><label for="contacts-public-role">公开人物职责</label><select id="contacts-public-role" data-contacts-public-role><option value="">全部公开职责</option><option value="speaker">讲者</option><option value="guest">嘉宾</option><option value="organizer">研讨会组织者</option><option value="moderator">主持人</option></select></div><div class="ah-admin-field"><label for="contacts-public-state">公开资料进度</label><select id="contacts-public-state" data-contacts-public-state><option value="">全部公开资料</option><option value="linked">已关联人物资料</option><option value="unlinked">尚未关联人物资料</option><option value="published">当前资料已发布</option><option value="unpublished">已建资料，尚未发布</option><option value="changed">公开历史／当前关联待核对</option><option value="no_consent">公开授权待核对</option><option value="no_portrait">照片待补</option></select></div><div class="ah-admin-field"><label for="contacts-search">搜索姓名、机构或城市</label><input type="search" id="contacts-search" data-contacts-search /></div><div class="ah-admin-field"><label for="contacts-category">当前身份 / 原始意向</label><select id="contacts-category" data-contacts-category><option value="">全部</option></select></div><div class="ah-admin-field"><label for="contacts-response">出席回复</label><select id="contacts-response" data-contacts-response><option value="">全部</option><option value="pending">尚未确认</option><option value="attending">已确认出席</option><option value="declined">不出席</option></select></div><div class="ah-admin-field"><label for="contacts-participation-filter">参与形式（内部）</label><select id="contacts-participation-filter" data-contacts-participation><option value="">全部</option><option value="__none">尚未标记</option>{participationForms.map(([value,label]) => <option value={value}>{label}</option>)}</select></div><div class="ah-admin-field"><label for="contacts-arrangement">现场安排</label><select id="contacts-arrangement" data-contacts-arrangement><option value="">全部</option><option value="assigned">已有关联安排</option><option value="unassigned">尚未安排</option><option value="sessions">已关联场次</option><option value="booths">已关联展位</option></select></div><div class="ah-admin-field"><label for="contacts-owner">负责同事</label><select id="contacts-owner" data-contacts-owner><option value="">全部负责同事</option></select></div><div class="ah-admin-field"><label for="contacts-progress">下一步 / 邀请进度</label><select id="contacts-progress" data-contacts-progress><option value="">全部进度</option><option value="unconverted">尚未代登记</option><option value="unsent">待准备或人工发出邀请</option><option value="unreplied">已联系待回复</option><option value="unassigned">确认出席待安排</option><option value="manually_sent">当前版已记录人工发出</option><option value="provider_accepted">服务商已接受，未证明送达</option><option value="unknown">发送结果待核对</option><option value="waitlisted">已登记候补，名额尚未确认</option><option value="admission_unknown">名额状态待核对</option><option value="stale">历史版本需核对</option><option value="excluded">拒绝联络或出席</option></select></div><label class="contacts-check"><input type="checkbox" data-contacts-due />只看待跟进</label></div><div class="ah-admin-table-wrap"><table class="contacts-table"><caption class="ah-sr-only">私有邀约对象、实际出席回复与参与安排</caption><thead><tr><th>对象</th><th>当前身份与原始意向</th><th>邀请函 / 发出记录</th><th>跟进</th><th>出席回复</th><th>身份与组织</th><th>现场安排</th><th>操作</th></tr></thead><tbody data-contacts-rows></tbody></table></div><p class="ah-admin-empty" data-contacts-empty>目前没有对象，请先导入并核对名单。</p></section>
        <section class="ah-admin-panel" data-invitation-panel hidden><div class="ah-admin-section-heading"><div><span class="ah-admin-eyebrow">A PERSONAL INVITATION</span><h2>邀请函生成器</h2><p>沿用提供的模板。生成图片不等于已经发出邀请，也不改变对方的出席回复。</p></div><button class="ah-admin-button" type="button" data-invitation-close>关闭</button></div><div class="contacts-invitation-layout"><form data-invitation-form><div class="ah-admin-field"><label for="invite-name">邀请函称呼</label><input id="invite-name" name="recipientName" required maxlength="120" autocomplete="off" /></div><div class="ah-admin-field"><label for="invite-date">日期</label><input id="invite-date" name="date" type="date" value={eventConfig.date.value} required /></div><div class="ah-admin-field"><label for="invite-time">时间</label><input id="invite-time" name="time" value={eventConfig.time.label} required maxlength="80" /></div><div class="ah-admin-field"><label for="invite-venue">地点</label><input id="invite-venue" name="venue" value={eventConfig.venue.address} required maxlength="160" /></div><label class="contacts-check"><input type="checkbox" name="confirmed" />已核实本次活动日期、时间、地点，可输出正式邀请函</label><p class="ah-admin-small">日期、时间与场地已确认，楼层、入口及交通资讯另行公布。正式输出前请核对本次填写；未勾选时，图片保留「暂定」标示。</p><div class="contacts-action-row"><button class="ah-admin-button" type="submit" data-invitation-preview disabled>预览邀请函</button><button class="ah-admin-button ah-admin-primary" type="button" data-invitation-download disabled>下载 PNG</button></div><hr /><p>已经通过微信或邮件亲自发出后，可在这里记录：</p><div class="ah-admin-field"><label for="invite-channel">实际发出渠道</label><select id="invite-channel" data-invitation-channel><option value="wechat">微信</option><option value="email">邮件</option><option value="other">其他</option></select></div><label class="contacts-check"><input type="checkbox" data-invitation-sent-confirm />我已通过所选渠道实际发出邀请</label><button class="ah-admin-button" type="button" data-invitation-record-sent disabled>记录已发出</button><p class="ah-admin-small">此按钮只保存工作人员的发出记录，不会发送消息。</p></form><div class="contacts-invitation-preview"><canvas width="1080" height="1920" data-invitation-canvas hidden></canvas><img data-invitation-image alt="个人邀请函 PNG 预览" hidden /><p data-invitation-caption>选择对象后点击预览，生成专属邀请函。预览图可右键或长按保存。</p></div></div><details data-communications-panel hidden><summary>旧版内容预览（不发送）</summary><p class="ah-admin-small">以下仅预览内容。<a href="/admin/settings/">前往设置与通知</a>核对实际邮件、微信群二维码与 Wallet 配置。</p><div class="contacts-communications"><div class="contacts-provider"><div class="contacts-provider-heading"><span class="ah-admin-eyebrow">APPLE WALLET</span><span class="contacts-setup-badge">未签名预览</span></div><h3>一张放进口袋的邀请</h3><p class="ah-admin-small" data-wallet-status>这里只生成未签名卡片预览。正式票券配置请到「设置与通知」核对。</p><div class="contacts-action-row"><button type="button" class="ah-admin-button" data-wallet-preview-button disabled>预览 Wallet 卡片</button></div><div class="contacts-wallet-card" data-wallet-preview hidden><p class="contacts-wallet-label">ARTDiCO HOST · 未签名预览</p><h4 data-wallet-title></h4><p class="contacts-wallet-name" data-wallet-name></p><div class="contacts-wallet-schedule"><p><span>日期</span><strong data-wallet-date></strong></p><p><span>时间</span><strong data-wallet-time></strong></p></div><p class="contacts-wallet-location" data-wallet-location></p><p class="contacts-wallet-notice" data-wallet-notice></p></div><p class="ah-admin-small">预览不会生成可导入的通行证，不含入场二维码，也不记录发出。</p></div><div class="contacts-provider"><div class="contacts-provider-heading"><span class="ah-admin-eyebrow">EMAILJS</span><span class="contacts-setup-badge">仅预览</span></div><h3>出席确认信</h3><p class="ah-admin-small" data-email-status>这里只预览旧版确认信文字，不代表实际寄件服务状态。</p><p class="ah-admin-small" data-email-eligibility>请先核实对方回复，并保存「已确认出席」，才可预览确认信。</p><div class="contacts-action-row"><button type="button" class="ah-admin-button" data-email-preview-button disabled>预览确认信</button></div><div class="contacts-email-preview" data-email-preview hidden><dl><dt>收件人</dt><dd data-email-to></dd><dt>主题</dt><dd data-email-subject></dd></dl><pre data-email-text></pre><p class="ah-admin-small">内容预览 · 尚未发送</p></div></div></div></details></section>
        </div>
      </section>
    </main><footer class="ah-admin-footer"><span>ARTDiCO HOST / PEOPLE</span><p>名单只用于本次活动筹备与跟进。</p><a href="/admin/">活动 / 嘉宾安排</a></footer>
  </div>
  <dialog class="ah-admin-dialog contacts-dialog" data-contact-dialog aria-labelledby="contact-dialog-title"><div class="ah-admin-dialog-heading"><div><span class="ah-admin-eyebrow">CONTACT & PLAN</span><h2 id="contact-dialog-title" data-contact-title>对象详情</h2></div><button type="button" class="ah-admin-icon-button" data-contact-close aria-label="关闭对象详情">×</button></div><div class="contacts-source" data-contact-profile></div><p class="ah-admin-small">基本资料与原问卷信息分别呈现。下方跟进与现场关联独立保存，不会自动公开人员。</p><p class="ah-admin-alert" data-contact-error role="alert" tabindex="-1" hidden></p><div class="people-save-unknown" data-contact-save-unknown hidden><p>保存结果尚待核对，填写内容仍保留。请先读取当前云端记录，系统不会自动重送或补登记。</p><button type="button" class="ah-admin-button" data-contact-check-save>核对云端保存结果</button></div><form method="post" data-contact-form><fieldset data-contact-fields><div class="ah-admin-field-row ah-admin-two-columns"><div class="ah-admin-field"><label for="contact-owner">跟进同事</label><input id="contact-owner" name="owner" maxlength="120" placeholder="填写负责同事姓名" /></div><div class="ah-admin-field"><label for="contact-priority">跟进优先级</label><select id="contact-priority" name="priority"><option value="normal">普通</option><option value="high">优先跟进</option></select></div></div><div class="ah-admin-field-row ah-admin-two-columns"><div class="ah-admin-field"><label for="contact-followup">下次跟进日期</label><input id="contact-followup" name="followUpAt" type="date" /></div><div class="ah-admin-field"><label for="contact-reply">对方最新出席回复</label><select id="contact-reply" name="responseStatus"><option value="pending">尚未确认</option><option value="attending">已确认出席</option><option value="declined">不出席</option></select></div></div><fieldset class="people-memberships"><legend>参与组织关系</legend><p class="ah-admin-small">明确选择已保存组织；成员关系不会自动成为嘉宾、占展位或确认名额。机构文字与原问卷保留。</p><p class="ah-admin-small" data-contact-membership-status></p><div data-contact-memberships></div><button class="ah-admin-button" type="button" data-contact-membership-add>＋ 关联组织</button></fieldset><fieldset class="contacts-participation" data-contact-participation><legend>全活动职责（可多选）</legend><p class="ah-admin-small">按工作人员已核对的安排标记，出席回复仍须另外保存。此处不会自动建立公开嘉宾、讲者或展位。</p><div class="contacts-participation-options">{participationForms.map(([value,label]) => <label><input type="checkbox" name="participationForms" value={value} data-participation-label={label} />{label}</label>)}</div></fieldset><div class="ah-admin-field"><label for="contact-notes">内部跟进备注</label><textarea id="contact-notes" name="notes" rows="3" maxlength="4000"></textarea></div><details><summary>安排参与场次</summary><p class="ah-admin-small">勾选场次后，可独立选择这场的讲者、主持或组织者职责。一人可在不同场次担任不同角色；全活动职责不自动套用。这里不确认名额或公开资料，重叠场次不能同时安排。</p><div class="contacts-assignments" data-contact-sessions></div></details><details><summary>安排出席展位</summary><p class="ah-admin-small">意向不等于已经获得展位。这里只关联已经建立的展位记录，不公开私人联系方式。</p><div class="contacts-assignments" data-contact-booths></div></details><div class="ah-admin-dialog-actions"><button class="ah-admin-button" type="button" data-contact-close>取消</button><button class="ah-admin-button ah-admin-primary" type="submit" data-contact-save disabled>保存跟进与安排</button></div></fieldset></form></dialog>
  <dialog class="ah-admin-dialog contacts-dialog" data-profile-dialog aria-labelledby="profile-dialog-title">
    <div class="ah-admin-dialog-heading"><div><span class="ah-admin-eyebrow">PRIVATE CONTACT</span><h2 id="profile-dialog-title" data-profile-title>新增联系人</h2></div><button type="button" class="ah-admin-icon-button" data-profile-close aria-label="关闭基本资料编辑">×</button></div>
    <p class="ah-admin-small" data-profile-source></p>
    <p class="ah-admin-alert" data-profile-error role="alert" tabindex="-1" hidden></p>
    <form method="post" data-profile-form autocomplete="off">
      <fieldset data-profile-fields>
        <div class="contacts-profile-grid">{profileFields.map(([name,label,max]) => <div class="ah-admin-field"><label for={'profile-'+name}>{label}{name === 'name' ? '（必填）' : ''}</label><input id={'profile-'+name} name={name} maxlength={max} required={name === 'name'} type={name === 'email' ? 'email' : 'text'} autocomplete="off" /><small hidden={name !== 'displayName'}>留空时使用姓名。</small></div>)}</div>
        <fieldset class="contacts-participation" data-profile-categories><legend>当前身份（可多选）</legend><div class="contacts-participation-options">{sourceLabels.categories.map(item => <label><input type="checkbox" name="categories" value={item.value} />{item.label}</label>)}</div><small>按已核对情况调整，不会自动建立讲者、工作人员或展位安排。取消全部勾选可清空当前身份。</small><p class="ah-admin-small" data-profile-original-categories></p></fieldset>
        <div class="ah-admin-field"><label for="profile-topics">关注主题</label><textarea id="profile-topics" name="topics" rows="2" maxlength="4000"></textarea></div>
        <div class="ah-admin-field"><label for="profile-background">背景与经验</label><textarea id="profile-background" name="background" rows="3" maxlength="10000"></textarea></div>
        <div class="ah-admin-field" data-profile-consent-field><label for="profile-consent">工作人员核实的联络同意</label><select id="profile-consent" name="contactConsent"><option value="unknown">尚未核实（默认）</option><option value="consented">本人已明确同意联络</option><option value="declined">本人不同意联络</option></select><small>这是工作人员依据实际授权所作的记录，不代表公开姓名、头像或出席确认。未核实或不同意时不能生成邀请。</small></div>
        <p class="contacts-source" data-profile-consent-readonly hidden></p>
        <div class="contacts-duplicate-warning" data-profile-duplicates hidden><p data-profile-duplicate-message></p><label class="contacts-check"><input type="checkbox" data-profile-duplicates-confirm />我已核对，仍要保存为独立联系人；不合并或覆盖其他记录</label></div>
        <div class="ah-admin-dialog-actions"><button type="button" class="ah-admin-button" data-profile-close>取消</button><button type="submit" class="ah-admin-button ah-admin-primary" data-profile-save disabled>保存联系人</button></div>
        <p class="ah-admin-small">收到后台保存回执后才更新名单；不会自动生成邀请、联系本人或发布资料。</p>
      </fieldset>
    </form>
  </dialog>
  <dialog class="ah-admin-dialog contacts-dialog" data-conversion-dialog aria-labelledby="conversion-title"><div class="ah-admin-dialog-heading"><h2 id="conversion-title">核对代登记与名额同步</h2><button class="ah-admin-icon-button" type="button" data-conversion-close aria-label="关闭名额预览">×</button></div><p class="ah-admin-small">只转换已核对的现有人員，每批最多 100 位。正式名额由共同 300 人规则确认，满额为候补；不会发送邀请、邮件或代替本人网站隐私同意。</p><p data-conversion-summary role="status"></p><ul class="people-conversion-results" data-conversion-entries></ul><p class="ah-admin-alert" data-conversion-error role="alert" hidden></p><div class="ah-admin-dialog-actions"><button class="ah-admin-button" type="button" data-conversion-close>取消</button><button class="ah-admin-button ah-admin-primary" type="button" data-conversion-confirm>确认代登记并核对名额</button></div></dialog>
  <script>
    import '../../../scripts/contacts.mjs';
  </script>
</SiteLayout>
<style is:global>
  .contacts-list-guide{margin:0 24px 24px;padding:14px 16px;border:1px solid #dfe6f0;border-radius:6px;font-size:12px;line-height:1.9}.contacts-list-guide summary,[data-communications-panel]>summary{cursor:pointer;font-weight:600}.contacts-list-guide ol{padding-left:20px;margin:12px 0}.contacts-list-guide li{margin:8px 0}.contacts-list-guide p{margin-bottom:0}[data-communications-panel]{margin:0 24px 24px;font-size:12px;line-height:1.9}[data-communications-panel] .contacts-communications{padding:0;margin:20px 0 0}[data-person-workspace-link]{display:block;margin-bottom:8px;white-space:normal}
  @media(max-width:600px){.contacts-list-guide,[data-communications-panel]{margin-inline:16px}}
</style>
