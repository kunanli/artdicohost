---
import StaffNavigation from '../../../components/StaffNavigation.astro';
import PersonConfirmation from '../../../components/PersonConfirmation.astro';
import PeopleResolution from '../../../components/PeopleResolution.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import '../../../styles/admin.css';
import '../../../styles/person.css';
import '../../../styles/people-relationships.css';
---
<SiteLayout title="个人工作页｜ARTDiCO HOST" description="工作人员核对同一人的名额、回复、职责、活动安排及邀请记录。">
  <div class="ah-admin person-app" data-person-app>
    <header class="ah-admin-header"><a class="ah-admin-brand" href="/admin/">ARTDiCO <span>HOST</span></a><nav aria-label="公开活动页面"><a class="ah-admin-back" href="https://artdico.host">查看活动页面 ↗</a></nav></header>
    <main class="ah-admin-main" id="main-content">
      <p class="ah-admin-status" data-person-status role="status" aria-live="polite"></p>
      <p class="ah-admin-alert" data-person-error role="alert" tabindex="-1" hidden></p>
      <section class="ah-admin-login-card" data-person-login-panel aria-labelledby="person-login-title">
        <h1 id="person-login-title">个人工作页</h1><p class="ah-admin-intro">登录后核对一位人员的报名、安排及通知记录。资料范围按工作人员权限显示。</p>
        <form method="post" data-person-login><div class="ah-admin-field"><label for="person-user">用户名或邮箱</label><input id="person-user" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="160" required /></div><div class="ah-admin-field"><label for="person-password">密码</label><input id="person-password" name="password" type="password" autocomplete="current-password" maxlength="1024" required /></div><button class="ah-admin-button ah-admin-primary" type="submit" data-person-login-submit disabled>登录个人工作页</button></form>
        <noscript><p>启用 JavaScript 后才可登录与读取资料。</p></noscript>
      </section>
      <section class="ah-admin-workspace-layout" data-person-workspace hidden>
        <StaffNavigation current="person" />
        <div class="ah-admin-workspace-content">
          <div class="ah-admin-page-heading"><div><p class="person-kicker">个人工作页</p><h1 data-person-name tabindex="-1">选择一位人员</h1><p data-person-identity></p></div><div class="person-account"><span data-person-user></span><button class="ah-admin-button" type="button" data-person-refresh>重新读取记录</button><button class="ah-admin-text-button" type="button" data-person-logout>退出登录</button></div></div>
          <section class="ah-admin-panel person-empty" data-person-empty><h2>从名单打开一位人员</h2><p data-person-empty-message>到人员或报名列表，选择「个人工作页」即可查看同一人的已保存记录。</p><div class="person-actions"><a class="ah-admin-button" href="/admin/contacts/">人员与报名</a><a class="ah-admin-button" href="/admin/registrations/">报名审核</a></div></section>
          <article data-person-record hidden>
            <section class="ah-admin-panel person-overview" aria-label="当前状态与下一步">
              <div class="person-status-strip" data-person-summary></div>
              <div class="person-primary-line"><button type="button" class="ah-admin-button ah-admin-primary" data-person-primary>核对记录</button><p class="person-note" data-person-primary-reason></p></div>
            </section>
            <details class="ah-admin-panel person-quick" data-person-quick-panel hidden>
              <summary data-person-quick-edit>回复与跟进</summary>
              <form data-person-quick-form>
                <div class="person-quick-row"><div class="ah-admin-field"><label for="person-response">本人回复</label><select id="person-response" name="responseStatus"><option value="pending">待回复</option><option value="attending">已答应出席</option><option value="declined">不出席</option></select></div><div class="ah-admin-field"><label for="person-owner">跟进同事</label><input id="person-owner" name="owner" maxlength="120" autocomplete="off" /></div><div class="ah-admin-field"><label for="person-follow-up">下次跟进</label><input id="person-follow-up" name="followUpAt" type="date" /></div></div>
                <div class="ah-admin-field"><label for="person-notes">跟进备注</label><textarea id="person-notes" name="notes" rows="3" maxlength="6000"></textarea></div>
                <p class="person-note" data-person-quick-outcome hidden></p>
                <p data-person-quick-state role="status" aria-live="polite"></p>
                <div class="person-quick-actions"><button type="submit" class="ah-admin-button" data-person-quick-save disabled>保存</button><button type="button" class="ah-admin-button" data-person-quick-check hidden>核对结果</button><button type="button" class="ah-admin-text-button" data-person-quick-retry hidden>重试原保存</button></div>
              </form>
            </details>
            <section class="person-service" data-person-service-panel hidden aria-label="通知与私人凭证">
              <div class="ah-admin-panel person-credential" data-person-credential>
                <button type="button" class="ah-admin-button" data-person-credential-prepare>查看私人参会页</button>
                <p class="person-note" data-person-credential-status role="status" aria-live="polite"></p>
                <div class="person-actions" data-person-credential-result hidden><a class="ah-admin-button" data-person-credential-open target="_blank" rel="noopener noreferrer">打开参会页</a><button type="button" class="ah-admin-button" data-person-credential-copy>复制链接</button></div>
                <textarea data-person-credential-fallback readonly hidden aria-label="私人参会链接"></textarea>
              </div>
              <PersonConfirmation />
            </section>
            <details class="person-more" data-person-more><summary>资料与历史</summary>
              <nav class="person-actions" data-person-actions aria-label="更多处理入口"></nav>
              <button type="button" class="ah-admin-button" data-person-service-open>通知与参会页</button>
              <PeopleResolution />
              <details class="ah-admin-panel person-panel" data-person-source-panel><summary>原问卷</summary><p class="person-note" data-person-source-state></p><dl class="person-facts" data-person-source></dl></details>
              <details class="ah-admin-panel person-panel"><summary>联络资料</summary><div data-person-profile></div></details>
              <details class="ah-admin-panel person-panel"><summary>名额与回复</summary><div data-person-admission></div></details>
              <details class="ah-admin-panel person-panel"><summary>报名与核查</summary><div data-person-registration></div></details>
              <details class="ah-admin-panel person-panel"><summary>职责与活动安排</summary><div data-person-arrangements></div></details>
              <details class="ah-admin-panel person-panel"><summary>参与组织</summary><div data-person-organizations></div></details>
              <details class="ah-admin-panel person-panel"><summary>志愿协作</summary><div data-person-volunteers></div></details>
              <details class="ah-admin-panel person-panel"><summary>通知历史</summary><div data-person-communications></div></details>
              <details class="ah-admin-panel person-panel"><summary>核对依据</summary><p class="person-note" data-person-linkage></p><ol class="person-steps" data-person-steps></ol><p class="person-note person-meta" data-person-meta></p></details>
            </details>
          </article>
        </div>
      </section>
    </main><footer class="ah-admin-footer"><span>ARTDiCO HOST</span><a href="/admin/contacts/">返回人员名单</a></footer>
  </div>
  <script>import '../../../scripts/person.mjs';</script>
</SiteLayout>
