---
import StaffNavigation from '../../../components/StaffNavigation.astro';
import PersonConfirmation from '../../../components/PersonConfirmation.astro';
import PeopleViews from '../../../components/PeopleViews.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import StaffAdmissions from '../../../components/StaffAdmissions.astro';
import {registrationSchema} from '../../../../shared/registration-schema.mjs';
import '../../../styles/admin.css';
import '../../../styles/registration-review.css';
import '../../../styles/admissions.css';
const statuses=[['new','新报名'],['in_review','核查中'],['awaiting_maria','待 Maria 审阅'],['approved','内部建议通过（不授予名额）'],['discussion','待讨论'],['not_this_time','本次不邀请'],['withdrawn','已撤回']];
const accommodation=[['not_requested','未申请'],['requested','已申请'],['pending','待核对'],['approved','已批准'],['declined','未批准']];
---
<SiteLayout title="报名与审核｜ARTDiCO HOST" description="工作人员私有报名核对、独立住宿审核与最小必要导出。">
  <div class="ah-admin" data-registration-admin>
    <header class="ah-admin-header"><a class="ah-admin-brand" href="/admin/">ARTDiCO <span>HOST / REGISTRATIONS</span></a><nav aria-label="公开活动页面"><a class="ah-admin-back" href="https://artdico.host">查看活动页面 <span aria-hidden="true">↗</span></a></nav></header>
    <main class="ah-admin-main" id="main-content">
      <p class="ah-admin-status" data-review-status role="status" aria-live="polite"></p><p class="ah-admin-alert" data-review-error role="alert" tabindex="-1" hidden></p>
      <section class="ah-admin-login-card" data-review-login-panel aria-labelledby="review-login-title"><span class="ah-admin-eyebrow">REVIEW WITH CARE</span><h1 id="review-login-title">核对每一份参与。</h1><p class="ah-admin-intro">使用具备报名审核权限的工作人员账号登录。名单及导出均由服务端校验权限。</p><form data-review-login method="post"><div class="ah-admin-field"><label for="review-user">用户名或邮箱</label><input id="review-user" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="160" required /></div><div class="ah-admin-field"><label for="review-password">密码</label><input id="review-password" name="password" type="password" autocomplete="current-password" maxlength="1024" required /></div><button class="ah-admin-button ah-admin-primary" type="submit" data-review-login-submit disabled>登录报名后台 →</button></form></section>
      <div class="review-account" data-review-account hidden><span data-review-user></span><button class="ah-admin-text-button" type="button" data-review-logout>退出登录</button></div>
      <section class="ah-admin-workspace-layout" data-review-workspace hidden aria-labelledby="review-title">
        <StaffNavigation current="registrations" />
        <div class="ah-admin-workspace-content">
        <div class="ah-admin-page-heading"><div><h1 id="review-title">报名审核</h1><p>查看申请、确认名额、取得参会凭证。原始资料、住宿与内部备注在详情中分别处理。</p></div><div class="review-heading-actions"><button class="ah-admin-button" type="button" data-review-refresh>刷新已保存记录</button><a id="delivery-settings-heading" href="/admin/settings/delivery/">确认信与 Wallet 设置 ↗</a></div></div>
        <PeopleViews current="registrations" />
        <div class="review-metrics" data-review-metrics></div>
        <section class="ah-admin-panel"><div class="ah-admin-section-heading"><div><h2>报名名单</h2></div></div>
<form class="review-filters" data-review-filters><div class="ah-admin-field"><label for="review-query">姓名 / 机构 / 报名编号</label><input id="review-query" name="query" type="search" maxlength="200" /></div><div class="ah-admin-field"><label for="review-category">身份类别</label><select id="review-category" name="category"><option value="">全部身份</option>{registrationSchema.identityOptions.map(item=><option value={item.value}>{item.label}</option>)}</select></div><div class="review-filter-actions"><button class="ah-admin-button ah-admin-primary" type="submit">应用筛选</button><button class="ah-admin-button" type="reset">清除筛选</button></div><details class="review-more-filters"><summary>更多筛选：城市、内部跟进、住宿与到场意向</summary><div class="review-filter-fields"><div class="ah-admin-field"><label for="review-city">城市</label><input id="review-city" name="city" maxlength="100" /></div><div class="ah-admin-field"><label for="review-status-filter">内部核查意见</label><select id="review-status-filter" name="status"><option value="">全部状态</option>{statuses.map(([value,label])=><option value={value}>{label}</option>)}</select></div><div class="ah-admin-field"><label for="review-accommodation-filter">住宿审核</label><select id="review-accommodation-filter" name="accommodation"><option value="">全部住宿状态</option>{accommodation.map(([value,label])=><option value={value}>{label}</option>)}</select></div><div class="ah-admin-field"><label for="review-attendance">到场意向</label><select id="review-attendance" name="attendance"><option value="">全部意向</option><option value="expected">预计到场</option><option value="uncertain">尚待确定</option><option value="unavailable">暂无法到场</option></select></div></div></details></form>
          <div class="review-results"><p data-review-result-count role="status" aria-live="polite"></p><button class="ah-admin-button" data-review-next type="button" hidden>下一页</button></div>
          <div class="ah-admin-table-wrap"><table class="review-table review-summary-table" role="table"><caption class="ah-sr-only">私有报名列表，点击查看资料并维护审核</caption><thead><tr><th scope="col">姓名 / 机构</th><th scope="col">参会状态</th><th scope="col">报名来源</th><th scope="col">操作</th></tr></thead><tbody data-review-rows></tbody></table></div><p class="ah-admin-empty" data-review-empty hidden>目前没有符合筛选的已保存报名。</p>
        </section>
        <details class="review-tools"><summary>名额、候补与代登记工具</summary><StaffAdmissions /></details>
        <details class="ah-admin-panel review-export"><summary>导出当前筛选名单</summary><div class="review-export-body"><div><h2>导出当前筛选</h2><p>用户原件与参会状态保留；Excel 分开呈现原填写资料、当前名额及实际职责。默认不含联络字段和完整回答，导出范围及文件摘要会记录审计。</p></div><div><label><input type="checkbox" data-review-export-contact />确有必要，包含结构化邮箱／微信</label><label><input type="checkbox" data-review-export-answers />包含完整原始回答（自由文本可能有联络信息）</label><label><input type="checkbox" data-review-export-arrangements />包含当前角色、场次职责及展位（另需人员邀约权限）</label><button class="ah-admin-button ah-admin-primary" type="button" data-review-export-xlsx>导出 Excel 工作簿</button><button class="ah-admin-button" type="button" data-review-export>导出简表 CSV</button><p class="ah-admin-small">只导出当前明确筛选的报名；未代登记或拒绝联络的筹备人员，请到人员后台单独导出全部联系人。不会生成公开链接，也不会自动发给其他人。</p></div></div></details>
        <p class="review-settings-link"><a id="staff-settings-title" href="/admin/settings/group/">微信群与管理工具 ↗</a></p>
        </div>
      </section>
    </main><footer class="ah-admin-footer"><span>ARTDiCO HOST / REVIEW</span><p>仅为本次活动核查所需，谨慎查看与分享。</p><a href="/admin/">返回工作人员后台</a></footer>
  </div>
  <dialog class="ah-admin-dialog review-dialog" data-review-dialog aria-labelledby="review-detail-title">
    <div class="ah-admin-dialog-heading"><div><span class="ah-admin-eyebrow">APPLICATION & SEPARATE DECISIONS</span><h2 id="review-detail-title" data-review-detail-title>报名资料</h2></div><button class="ah-admin-icon-button" type="button" data-review-detail-close aria-label="关闭报名资料">×</button></div>
    <p class="ah-admin-alert" data-review-detail-error role="alert" tabindex="-1" hidden></p><p class="review-provenance" data-review-provenance></p>
    <section class="ah-admin-panel" data-review-admission aria-label="正式申请审核">
      <h3>参会状态</h3><p class="review-admission-state" data-review-admission-status>正在核对实际名额状态。</p><p class="ah-admin-small" data-review-admission-help>正在核对当前名额。</p>
      <div class="contacts-action-row" data-review-approval-actions><button class="ah-admin-button ah-admin-primary" type="button" data-review-approve disabled>审核通过并分配名额</button><button class="ah-admin-button" type="button" data-review-reject disabled>不通过申请</button></div>
      <p class="ah-admin-status" data-review-admission-notice role="status" aria-live="polite"></p>
      <div class="admissions-pending" data-review-admission-pending hidden><p>上一项名额操作结果尚未确认。请使用原操作再次核对，读取最新状态不会代替确认回执。</p><button class="ah-admin-button" type="button" data-review-admission-retry>再次确认同一操作</button></div>
    </section>
    <PersonConfirmation /><section class="review-ticket" data-review-ticket hidden aria-labelledby="review-ticket-title">
      <h3 id="review-ticket-title">参会凭证与 Apple Wallet</h3><p>已确认名额。取得私人确认页后，可在 iPhone 的 Safari 中加入 Wallet。</p>
      <button type="button" class="ah-admin-button ah-admin-primary" data-review-confirmation-prepare>取得私人确认页</button>
      <p class="ah-admin-status" data-review-confirmation-status role="status" aria-live="polite"></p>
      <div class="review-ticket-links" data-review-confirmation-result hidden><a class="ah-admin-button" data-review-confirmation-open target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">打开确认页 ↗</a><button type="button" class="ah-admin-button" data-review-confirmation-copy>复制私人链接</button><p class="ah-admin-small">链接可查看此人的确认资料，请仅私下交付本人或获授权的人员。取得链接不会寄信。</p><input class="review-link-fallback" data-review-confirmation-fallback type="text" readonly autocomplete="off" aria-label="私人确认页链接，供手动复制" hidden /></div>
    </section>
    <section class="review-basics"><h3>基本资料</h3><dl data-review-summary></dl></section>
    <details class="review-original"><summary>原始报名资料与问卷</summary><dl data-review-details></dl></details>
    <form data-review-form>
      <details class="review-detail-group"><summary>内部跟进与备注</summary><p class="ah-admin-small">仅保存内部意见，不改变参会名额。</p>
      <div class="ah-admin-field"><label for="decision-status">内部核查意见</label><select id="decision-status" name="status">{statuses.map(([value,label])=><option value={value}>{label}</option>)}</select></div>
      <div class="ah-admin-field-row ah-admin-two-columns"><div class="ah-admin-field"><label for="decision-recommendation">内部推荐</label><select id="decision-recommendation" name="recommendation"><option value="">尚未标注</option><option value="priority">优先</option><option value="consider">考虑</option><option value="follow_up">需跟进</option></select></div><div class="ah-admin-field"><label for="decision-owner">内部负责人</label><input id="decision-owner" name="assignedTo" maxlength="120" /></div></div>
      <div class="ah-admin-field"><label for="decision-role">建议参与角色 / 安排</label><input id="decision-role" name="proposedRole" maxlength="240" /><small>此栏是核查意见，实际场次与展位请到「人员 / 邀约」分别安排。</small></div>
      <div class="ah-admin-field"><label for="decision-notes">核验与内部备注</label><textarea id="decision-notes" name="internalNotes" maxlength="4000" rows="4"></textarea></div>
      <div class="ah-admin-field-row ah-admin-two-columns"><div class="ah-admin-field"><label for="decision-last-contact">上次联系日期</label><input id="decision-last-contact" name="lastContactDate" type="date" /></div><div class="ah-admin-field"><label for="decision-next-step">下一步</label><input id="decision-next-step" name="nextStep" maxlength="1000" /></div></div>
      </details>
      <details class="review-detail-group"><summary>住宿安排</summary><div class="ah-admin-field"><label for="decision-accommodation">住宿审核</label><select id="decision-accommodation" name="accommodationStatus">{accommodation.map(([value,label])=><option value={value}>{label}</option>)}</select><small>住宿批准与参会确认分别保存；不会自动分配房间。</small></div></details>
      <details class="review-maria"><summary>Maria 审阅与正式通知记录</summary><p class="ah-admin-small">此处仅记录人工审阅与人工通知，不会发送名单、批准申请或触发邮件。正式申请审核请使用上方明确操作。</p><div class="ah-admin-field-row ah-admin-two-columns"><div class="ah-admin-field"><label for="decision-maria-date">审阅日期</label><input id="decision-maria-date" name="mariaReviewDate" type="date" /></div><div class="ah-admin-field"><label for="decision-maria-result">审阅结果</label><select id="decision-maria-result" name="mariaDecision"><option value="">尚无记录</option><option value="approved">已确认</option><option value="discussion">待讨论</option><option value="not_this_time">本次不邀请</option></select></div></div><div class="ah-admin-field"><label for="decision-maria-feedback">审阅反馈</label><textarea id="decision-maria-feedback" name="mariaFeedback" maxlength="2000" rows="3"></textarea></div><div class="ah-admin-field"><label for="decision-invitation">人工正式通知</label><select id="decision-invitation" name="invitationStatus"><option value="not_sent">尚未通知</option><option value="to_send">准备通知</option><option value="sent">已人工通知</option><option value="declined">对方婉拒</option></select></div></details>
      <p class="ah-admin-small" data-review-deletion-state></p><div class="ah-admin-dialog-actions"><details class="review-delete-tools"><summary>其他操作</summary><button class="ah-admin-button" type="button" data-review-deletion>登记删除申请</button></details><button class="ah-admin-button" type="button" data-review-detail-close>关闭</button><button class="ah-admin-button ah-admin-primary" type="submit" data-review-save aria-label="保存当前报名核查意见" disabled>保存内部记录</button></div>
    </form>
  </dialog>
  <script>import '../../../scripts/registration-review.mjs';</script>
</SiteLayout>
