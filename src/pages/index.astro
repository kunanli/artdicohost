---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Agenda from '../components/Agenda.astro';
import Booths from '../components/Booths.astro';
import StudentShowcase from '../components/StudentShowcase.astro';
import Guests from '../components/Guests.astro';
import Recruitment from '../components/Recruitment.astro';
import WalletApplication from '../components/WalletApplication.astro';
import Registration from '../components/Registration.astro';
import VenueFaq from '../components/VenueFaq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { eventConfig } from '../config/event.mjs';
import shareImage from '../assets/home/event-share.png';
import '../styles/home.css';
import '../styles/home-scroll.css';
import '../styles/home-hero-motion.css';
import '../styles/home-typography.css';
import '../styles/language.css';
const shareUrl = new URL(shareImage.src, 'https://artdico.host').href;
---
<SiteLayout title={eventConfig.seo.title} description={eventConfig.seo.description} themeColor="#000000">
  <Fragment slot="head">
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GlobalGameJam 中国交流聚会 × ARTDiCO HOST 学生嘉年华，2026 年 12 月 5 日，深圳前海。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareUrl} />
    <link rel="image_src" href={shareImage.src} />
  </Fragment>
  <div id="artdico-host" class="ah-product ah-festival ah-cosmos">
    <SiteHeader />
    <main id="main-content">
      <Hero />
      <div class="ah-page-content"><About /><Guests /><Booths /><StudentShowcase /><Agenda /><Recruitment /><Registration /><WalletApplication /><VenueFaq /></div>
    </main>
    <SiteFooter />
  </div>
</SiteLayout>
<script>
  import '../scripts/public-content.mjs';
  import '../scripts/home-motion.mjs';
  import '../scripts/home-scroll.mjs';
  import '../scripts/hero-interaction.mjs';
  import '../scripts/language.mjs';
</script>
