---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Agenda from '../components/Agenda.astro';
import Booths from '../components/Booths.astro';
import StudentShowcase from '../components/StudentShowcase.astro';
import Guests from '../components/Guests.astro';
import Recruitment from '../components/Recruitment.astro';
import Registration from '../components/Registration.astro';
import VenueFaq from '../components/VenueFaq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { eventConfig } from '../config/event.mjs';
---
<SiteLayout title={eventConfig.seo.title} description={eventConfig.seo.description}>
  <div id="artdico-host" class="ah-product ah-creative ah-festival">
    <SiteHeader />
    <main id="main-content">
      <Hero />
      <div class="ah-page-content"><About /><Guests /><Agenda /><StudentShowcase /><Booths /><Recruitment /><Registration /><VenueFaq /></div>
    </main>
    <SiteFooter />
  </div>
</SiteLayout>
<script>
  import '../scripts/public-content.mjs';
</script>
