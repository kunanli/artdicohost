---
const apiOrigin = import.meta.env.PUBLIC_API_BASE || '';
if (apiOrigin && apiOrigin !== 'https://api.artdico.host') throw new Error('Unexpected private link API');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>参会信息 · ARTDiCO HOST</title>
    <style>body{margin:0;background:#f5f7fc;color:#13213d;font:18px/1.7 system-ui,sans-serif}main{max-width:640px;margin:12vh auto;padding:24px}h1{font-size:28px;line-height:1.3}a{color:#3d40ed}button{font:inherit;padding:10px 20px;border:1px solid #c4cbe0;border-radius:8px;background:#fff;color:#13213d}button[hidden]{display:none}</style>
  </head>
  <body data-entry-link-api={apiOrigin}>
    <main><p>ARTDiCO HOST</p><h1>参会信息</h1><p data-entry-link-status role="status">正在核对私人链接…</p><button data-entry-link-retry hidden>重新读取</button><p><a href="/">返回活动首页</a></p><noscript>请启用 JavaScript 以打开私人参会页。</noscript></main>
  </body>
</html>
<script>
  import '../../scripts/entry-link.mjs';
</script>
