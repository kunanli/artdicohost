---
import '../../styles/confirmation.css';
import { PUBLIC_AGENDA_URL, PUBLIC_CONTACT_EMAIL, PUBLIC_EVENT_DETAILS_URL, PUBLIC_REGISTRATION_URL, PUBLIC_SHOWCASE_URL } from '../../config/event.mjs';
import { CARD_IMAGE } from '../../lib/commemorative-card-image.mjs';
import LanguagePicker from '../../components/LanguagePicker.astro';
const apiOrigin = import.meta.env.PUBLIC_API_BASE || '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#ffffff" />
    <title>ARTDiCO HOST</title>
  </head>
  <body class="confirmation-page" data-language-root data-confirmation-page data-confirmation-api={apiOrigin}>
    <a class="confirmation-skip" href="#confirmation-main">跳到主要内容</a>
    <header class="confirmation-header"><a href="/">ARTDiCO HOST</a><a href="/#agenda" data-confirmation-agenda>活动日程</a><LanguagePicker /></header>
    <main id="confirmation-main" tabindex="-1">
      <section class="confirmation-card">
        <p class="confirmation-state" data-confirmation-state aria-hidden="true">ARTDiCO HOST</p>
        <h1 data-confirmation-heading tabindex="-1">正在打开私人页面…</h1>
        <p class="confirmation-intro" data-confirmation-intro>请稍候。</p>
        <p class="confirmation-error" data-confirmation-error role="alert" hidden></p>
        <p data-confirmation-external hidden><a href={PUBLIC_REGISTRATION_URL} rel="noreferrer">前往活动行活动页</a> · <a href="/#wallet-card-application">申请电子纪念卡</a></p>
        <div data-confirmation-content hidden>
          <div class="confirmation-person"><strong data-confirmation-name data-i18n-preserve></strong><span data-confirmation-organization></span></div>
          <p class="confirmation-community" data-confirmation-community data-i18n-preserve hidden></p>
          <p class="confirmation-contact" data-confirmation-outcome-contact hidden>如需核对，请联系 <a href={'mailto:'+PUBLIC_CONTACT_EMAIL}>{PUBLIC_CONTACT_EMAIL}</a>。<button type="button" data-confirmation-contact-copy>复制邮箱</button></p>
          <p class="confirmation-facts-warning" data-confirmation-facts-warning role="status" hidden>活动资料待核对，请稍后重新读取。</p>
          <dl class="confirmation-details">
            <dt>日期</dt><dd data-confirmation-date></dd>
            <dt>时间</dt><dd data-confirmation-time></dd>
            <dt>地点</dt><dd data-confirmation-venue></dd>
          </dl>
          <section class="confirmation-save" data-confirmation-save aria-labelledby="confirmation-save-heading">
            <h2 id="confirmation-save-heading" data-confirmation-save-heading>保存参会信息</h2>
            <div id="confirmation-card-claim" hidden>
              <div class="confirmation-actions"><button type="button" id="confirmation-card-claim-button" aria-describedby="confirmation-card-claim-status">领取纪念卡</button></div>
              <p class="confirmation-action-status confirmation-claim-status" id="confirmation-card-claim-status" role="status"></p>
            </div>
            <p class="confirmation-collector" hidden>
              <span id="confirmation-card-collector-label">纪念卡编号</span>
              <strong id="confirmation-card-collector-number" tabindex="-1" aria-describedby="confirmation-card-collector-label" data-i18n-preserve></strong>
            </p>
            <div class="confirmation-actions">
              <a data-confirmation-jpeg-download download="artdico-host-card.jpg" hidden>下载 JPEG 纪念卡</a>
              <button type="button" data-confirmation-copy>复制私人链接</button>
              <button type="button" data-confirmation-wallet hidden><img src="/wallet/add-to-apple-wallet-cn.svg" alt="添加到 Apple 钱包" data-confirmation-wallet-badge decoding="async" referrerpolicy="no-referrer" hidden /><span data-confirmation-wallet-label>加入 Apple Wallet</span></button>
            </div>
            <p class="confirmation-device" data-confirmation-device hidden></p>
            <section id="confirmation-safari-guide" class="confirmation-safari-guide" data-confirmation-safari-guide hidden aria-labelledby="confirmation-safari-heading">
              <h3 id="confirmation-safari-heading" tabindex="-1">在 Safari 中添加票券</h3>
              <ol><li data-confirmation-wechat-step hidden>点微信右上角「…」，查看是否有「在浏览器打开」选项。</li><li>复制私人链接，粘贴到 Safari 地址栏打开。</li><li>在 Safari 中点「加入 Apple Wallet」，再按系统提示确认。</li></ol>
              <div class="confirmation-small-actions"><button type="button" data-confirmation-safari-copy>复制私人链接</button><button type="button" data-confirmation-safari-close>收起指引</button></div>
            </section>
            <p class="confirmation-action-status" data-confirmation-action-status role="status" aria-live="polite"></p>
            <p class="confirmation-action-status confirmation-jpeg-status" data-confirmation-jpeg-status role="status" aria-live="polite"></p>
            <div class="confirmation-jpeg-preview" data-confirmation-jpeg-preview hidden>
              <img data-confirmation-jpeg-image data-i18n-preserve alt="你的电子纪念卡" width={CARD_IMAGE.width} height={CARD_IMAGE.height} decoding="async" />
              <p>手机可长按图片保存。</p>
            </div>
            <div class="confirmation-copy-fallback" data-confirmation-copy-fallback hidden><label for="confirmation-private-link">复制并私下保存此链接</label><input id="confirmation-private-link" data-confirmation-private-link readonly autocomplete="off" /></div>
            <p class="confirmation-private">此链接可查看你的最新状态，请私下保存，不要转发。</p>
            <details class="confirmation-more" data-confirmation-more>
              <summary>更多保存方式</summary>
              <div class="confirmation-small-actions"><button type="button" data-confirmation-print>打印 / 存为 PDF</button><button type="button" data-confirmation-invitation hidden>生成个人邀请函 PNG</button></div>
              <section class="confirmation-invitation" data-confirmation-invitation-preview hidden aria-labelledby="confirmation-invitation-heading">
                <h3 id="confirmation-invitation-heading">个人邀请函</h3>
                <img data-confirmation-invitation-image alt="个人活动邀请函" width="1080" height="1920" decoding="async" referrerpolicy="no-referrer" />
                <a data-confirmation-invitation-download download="artdico-host-invitation.png">下载 PNG 邀请函</a>
                <p>手机可长按图片保存；活动前请以私人页最新状态为准。</p>
              </section>
            </details>
          </section>
          <details class="confirmation-card-profile" data-confirmation-card-profile hidden>
            <summary>纪念卡个人资料</summary>
            <dl>
              <div data-confirmation-card-organization><dt>学校／机构</dt><dd data-i18n-preserve></dd></div>
              <div data-confirmation-card-phone><dt>电话</dt><dd data-i18n-preserve></dd></div>
            </dl>
          </details>
          <nav class="confirmation-event-guide" data-confirmation-event-guide aria-labelledby="confirmation-event-guide-heading" hidden>
            <h2 id="confirmation-event-guide-heading">活动指南</h2>
            <p data-confirmation-map-address hidden></p>
            <ul>
              <li><a href={PUBLIC_EVENT_DETAILS_URL}>活动详情</a></li>
              <li data-confirmation-map-item hidden><a data-confirmation-map>Apple 地图导航</a></li>
              <li><a href={PUBLIC_AGENDA_URL}>讲座与活动日程</a></li>
              <li><a href={PUBLIC_SHOWCASE_URL}>参展游戏与作品</a></li>
              <li><a href={PUBLIC_REGISTRATION_URL}>活动行活动页</a></li>
            </ul>
          </nav>
          <section class="confirmation-group" data-confirmation-group hidden aria-labelledby="confirmation-group-heading">
            <h2 id="confirmation-group-heading">加入活动微信群</h2>
            <div data-confirmation-group-image></div>
            <p data-confirmation-group-status role="status"></p>
            <div class="confirmation-small-actions"><button type="button" data-confirmation-group-refresh>重新读取群码</button><button type="button" data-confirmation-contact-copy>复制联系邮箱</button></div>
            <details class="confirmation-group-help" data-confirmation-group-help><summary>群码有效期说明</summary><p class="confirmation-group-validity">图片链接最长 10 分钟；微信群码最长 7 天，可能提前更换。图片失效后可重新读取，不代表微信群码已过期。</p></details>
          </section>
          <details class="confirmation-registration" data-confirmation-registration>
            <summary>登记信息</summary>
            <dl class="confirmation-details"><dt>活动</dt><dd data-confirmation-event></dd><dt>登记编号</dt><dd class="confirmation-reference" data-confirmation-reference data-i18n-preserve></dd></dl>
            <p class="confirmation-note">讲者、展位与住宿安排分别确认。</p>
          </details>
          <details class="confirmation-notice-records" data-confirmation-notice-records>
            <summary>通知记录</summary>
            <p class="confirmation-email" data-confirmation-email></p>
            <dl class="confirmation-notifications" data-confirmation-notifications hidden>
              <dt>申请回执</dt><dd data-confirmation-application-received></dd>
              <dt>行前提醒</dt><dd data-confirmation-pre-event-reminder></dd>
            </dl>
          </details>
          <p class="confirmation-printed">打印仅保留当前结果；活动前请重新打开确认页核对最新状态。</p>
        </div>
        <div class="confirmation-secondary"><button type="button" data-confirmation-refresh>重新读取</button><a href="/">返回活动首页</a></div>
        <details class="confirmation-support"><summary>遗失链接或需要帮助？</summary><p>请联系 <a href={'mailto:'+PUBLIC_CONTACT_EMAIL}>{PUBLIC_CONTACT_EMAIL}</a>。主办方核对本人后，会私下交付查询链接。<button type="button" data-confirmation-contact-copy>复制邮箱</button></p><p data-confirmation-contact-status role="status" aria-live="polite"></p></details>
      </section>
    </main>
    <noscript><p class="confirmation-noscript">请启用 JavaScript 打开私人页面，或通过原联系渠道联络筹备团队。</p></noscript>
  </body>
</html>
<script>
  import '../../scripts/language.mjs';
  import '../../scripts/confirmation.mjs';
</script>
